---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MatrixIntro from "../components/MatrixIntro.astro";
import { Font } from "astro:assets";

interface Props {
  title: string;
  description: string;
  image?: string;
  url?: string;
  // Datos estructurados (schema.org) de la página, si los tiene.
  jsonLd?: Record<string, unknown>;
  // Páginas que no deben indexarse (404).
  noindex?: boolean;
}

const { title, description, image, url, jsonLd, noindex } = Astro.props;
// Sale de `site` en astro.config.mjs.
const siteUrl = Astro.site?.origin ?? "";
const pageUrl = url ? `${siteUrl}${url}` : siteUrl;
const ogImage = image ? `${siteUrl}${image}` : `${siteUrl}/og-default.jpg`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" />
    <title>{title}</title>

    <!-- Inicialización temprana del tema visual para evitar parpadeos -->
    <script is:inline>
      // Sin píldora elegida, la web arranca en modo neutro (sin color) hasta que se elige.
      try {
        const theme = localStorage.getItem("portfolio-theme");
        if (theme === "matrix") {
          document.documentElement.dataset.theme = "matrix";
        } else if (theme !== "abyss") {
          document.documentElement.dataset.theme = "neutral";
        }
      } catch {}
    </script>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={pageUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Canonical -->
    <link rel="canonical" href={pageUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      jsonLd && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }
  </head>
  <body class="bg-background text-foreground antialiased">
    <!-- Fondo de toda la página: rejilla ASCII que reacciona al ratón (src/scripts/ascii-field.ts) -->
    <canvas
      data-ascii-field
      aria-hidden="true"
      class="pointer-events-none fixed inset-0 -z-10 h-full w-full"></canvas>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-20 focus:bg-surface focus:px-4 focus:py-2"
    >
      Saltar al contenido
    </a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <MatrixIntro />
    <script>
      import { initLenis } from "@/scripts/lenis";
      import { initAsciiField } from "@/scripts/ascii-field";
      initLenis();
      const field = document.querySelector<HTMLCanvasElement>("[data-ascii-field]");
      if (field) initAsciiField(field);
    </script>
  </body>
</html>
