---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Página no encontrada · Manuel Casinos Pérez"
  description="La página que buscas no existe o se ha movido."
  image="/og-default.jpg"
  url="/404"
>
  <section class="mx-auto max-w-5xl px-4 py-32 font-mono">
    <h1 class="text-2xl sm:text-3xl">
      <span class="sr-only">Página no encontrada (error 404)</span>
      <!-- prettier-ignore -->
      <span aria-hidden="true"><span class="text-accent">~</span> <span class="text-muted">$</span> cd <span class="text-accent-2">esta-página</span></span>
    </h1>
    <p class="mt-4 text-muted">
      bash: cd: esta-página: no existe el archivo o directorio (404)
    </p>
    <div class="mt-10 flex flex-wrap gap-3 text-sm">
      <a
        href="/"
        class="term-select inline-flex items-center gap-2 border border-accent/50 px-5 py-3 text-accent"
      >
        <span aria-hidden="true">$</span> cd ~
      </a>
      <a
        href="/#proyectos"
        class="term-select inline-flex items-center gap-2 border border-border px-5 py-3 text-foreground"
      >
        <span aria-hidden="true">$</span> ls proyectos
      </a>
    </div>
  </section>
</Layout>
