---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Página no encontrada · Manuel Casinos Pérez"
  description="La página que buscas no existe o se ha movido."
  image="/og-default.jpg"
  url="/404"
>
  <section class="mx-auto max-w-5xl px-4 py-32 text-center">
    <h1 class="text-6xl font-bold tracking-tight text-accent">404</h1>
    <h2 class="mt-4 text-2xl font-semibold">Página no encontrada</h2>
    <p class="mt-3 text-muted max-w-md mx-auto">
      Lo sentimos, la página que buscas no existe o se ha movido.
    </p>
    <div class="mt-8 flex justify-center gap-4">
      <a
        href="/"
        class="rounded-lg bg-accent px-6 py-3 text-sm font-medium text-background hover:bg-accent/90 transition-colors"
      >
        Volver al inicio
      </a>
      <a
        href="#proyectos"
        class="rounded-lg border border-border px-6 py-3 text-sm font-medium text-foreground hover:bg-surface transition-colors"
      >
        Ver proyectos
      </a>
    </div>
  </section>
</Layout>