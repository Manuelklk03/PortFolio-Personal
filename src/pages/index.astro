---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import ProjectEntry from "../components/ProjectEntry.astro";
import Cursor from "../components/Cursor.astro";
import AsciiScene from "../components/ascii/AsciiScene.astro";
import AsciiName from "../components/ascii/AsciiName.astro";
import { projects } from "../data/projects";
import { profile } from "../data/profile";
import { techStack } from "../data/tech";

const contactLinks = [
  {
    command: "mail",
    label: profile.email,
    href: `mailto:${profile.email}`,
    external: false,
  },
  {
    command: "open github",
    label: "github.com/Manuelklk03",
    href: profile.github,
    external: true,
  },
  {
    command: "open linkedin",
    label: "in/manuel-casinos-perez",
    href: profile.linkedin,
    external: true,
  },
];
---

<Layout
  title="Manuel Casinos Pérez · Portfolio"
  description="Portfolio de Manuel Casinos Pérez, desarrollador FullStack en Valencia: proyectos, stack y contacto."
  image="/og-default.jpg"
  url="/"
>
  <Cursor />

  <section id="inicio" class="relative isolate scroll-mt-20 overflow-hidden">
    <AsciiScene />
    <div class="mx-auto max-w-5xl px-4 py-24 sm:py-32">
      <!-- prettier-ignore -->
      <p class="font-mono text-sm text-muted"><span class="text-accent">~/portfolio</span> $ whoami<span aria-hidden="true" class="animate-blink text-accent">█</span></p>
      <h1 class="sr-only">Manuel Casinos Pérez</h1>
      <div class="mt-6">
        <AsciiName lines={["MANUEL", "CASINOS"]} />
      </div>
      <p class="mt-8 max-w-xl text-lg text-foreground">
        Desarrollador FullStack en Valencia.
      </p>
      <p class="mt-2 font-mono text-sm text-accent-2">
        Java · Spring Boot · Angular · TypeScript · React
      </p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a
          href="#proyectos"
          class="inline-flex items-center gap-2 rounded-md bg-accent px-5 py-3 font-mono text-sm font-medium text-background transition hover:bg-foreground"
        >
          <span aria-hidden="true">$</span> ls proyectos
        </a>
        <a
          href={profile.cvUrl ? "#cv" : "#contacto"}
          class="inline-flex items-center gap-2 rounded-md border border-accent/50 px-5 py-3 font-mono text-sm text-accent transition hover:border-accent hover:bg-accent/10"
        >
          <span aria-hidden="true">$</span>
          {profile.cvUrl ? "cat cv.pdf" : "mail contacto"}
        </a>
      </div>
    </div>
  </section>

  <Section id="sobre-mi" title="Sobre mí" command="cat perfil">
    <div data-reveal class="max-w-3xl">
      <dl class="grid gap-x-8 gap-y-3 font-mono text-sm sm:grid-cols-[9rem_1fr] sm:text-base">
        {profile.about.map((row) => (
          <Fragment>
            <dt class="text-accent-2">{row.key}</dt>
            <dd class="text-foreground">{row.value}</dd>
          </Fragment>
        ))}
      </dl>
      <p class="mt-8 max-w-2xl text-muted">{profile.aboutNote}</p>
    </div>
  </Section>

  <Section id="proyectos" title="Proyectos" command="ls -l">
    <ul class="border-t border-border">
      {projects.map((project) => (
        <ProjectEntry project={project} />
      ))}
    </ul>
  </Section>

  <Section id="tecnologias" title="Tecnologías" command="stack --list">
    <div data-reveal class="grid gap-10 font-mono text-sm sm:grid-cols-2">
      <div>
        <h3 class="text-accent">--base</h3>
        <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-2">
          {techStack.base.map((tech) => (
            <li class="text-foreground">
              <span aria-hidden="true" class="text-accent">
                ▸{" "}
              </span>
              {tech}
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="text-accent-2">--aprendiendo</h3>
        <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-2">
          {techStack.learning.map((tech) => (
            <li class="text-muted">
              <span aria-hidden="true" class="text-accent-2">
                ○{" "}
              </span>
              {tech}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  {profile.cvUrl && (
    <Section id="cv" title="Currículum" command="open curriculum.pdf">
      <div data-reveal>
        <div class="overflow-hidden rounded-lg border border-border bg-surface/80">
          <object
            data={profile.cvUrl}
            type="application/pdf"
            class="h-[80vh] w-full"
            aria-label={`Currículum de ${profile.name} en PDF`}
          >
            <p class="p-6 text-muted">
              Tu navegador no puede mostrar el PDF aquí.{" "}
              <a href={profile.cvUrl} class="text-accent underline">
                Ábrelo o descárgalo
              </a>
              .
            </p>
          </object>
        </div>
        <a
          href={profile.cvUrl}
          download
          class="mt-4 inline-flex items-center gap-2 rounded-md border border-accent/50 px-5 py-3 font-mono text-sm text-accent transition hover:border-accent hover:bg-accent/10"
        >
          <span aria-hidden="true">↓</span> descargar PDF
        </a>
      </div>
    </Section>
  )}

  <Section id="contacto" title="Contacto" command="ping manuel">
    <div data-reveal>
      <p class="max-w-xl text-muted">
        Escríbeme por correo o revisa mi trabajo en GitHub y LinkedIn.
      </p>
      <ul class="mt-8 grid gap-3 sm:grid-cols-3">
        {contactLinks.map((link) => (
          <li>
            <a
              href={link.href}
              {...(link.external
                ? { target: "_blank", rel: "noopener noreferrer" }
                : {})}
              class="group flex h-full flex-col gap-2 rounded-lg border border-border bg-surface/70 p-5 font-mono transition-colors duration-200 hover:border-accent hover:bg-accent/5"
            >
              <span class="text-xs text-muted">
                <span class="text-accent-2">$</span> {link.command}
              </span>
              <span class="break-all text-accent transition-colors group-hover:text-foreground">
                {link.label}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <script>
    import { initReveal } from "@/scripts/reveal";
    // La entrada del inicio la hacen las partículas del nombre; aquí solo las secciones.
    initReveal();
  </script>
</Layout>
