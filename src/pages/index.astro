---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import ProjectEntry from "../components/ProjectEntry.astro";
import Cursor from "../components/Cursor.astro";
import AsciiScene from "../components/ascii/AsciiScene.astro";
import AsciiName from "../components/ascii/AsciiName.astro";
import AsciiSeam from "../components/ascii/AsciiSeam.astro";
import { blockLetters, imageAscii } from "../lib/ascii-art";
import { projects } from "../data/projects";
import { profile } from "../data/profile";
import { techStack } from "../data/tech";

// Retrato ASCII de Manuel para «Sobre mí», al estilo de neofetch (se genera al compilar).
// Mientras no exista la foto se muestran sus iniciales.
const portrait =
  (await imageAscii("src/assets/portrait.jpg", 64, 36, {
    left: 0.12,
    top: 0.06,
    width: 0.76,
    height: 0.66,
  })) ?? blockLetters("MC");
const swatches = [
  "text-surface",
  "text-border",
  "text-muted",
  "text-accent-2",
  "text-accent",
  "text-foreground",
];

const contactLinks = [
  {
    command: "mail",
    label: profile.email,
    href: `mailto:${profile.email}`,
    external: false,
  },
  {
    command: "open github",
    label: "github.com/Manuelklk03",
    href: profile.github,
    external: true,
  },
  {
    command: "open linkedin",
    label: "in/manuel-casinos-perez",
    href: profile.linkedin,
    external: true,
  },
];
---

<Layout
  title="Manuel Casinos Pérez · Portfolio"
  description="Portfolio de Manuel Casinos Pérez, desarrollador FullStack en Valencia: proyectos, stack y contacto."
  image="/og-default.jpg"
  url="/"
>
  <Cursor />

  <section id="inicio" class="relative isolate scroll-mt-20 overflow-hidden">
    <AsciiScene />
    <div class="mx-auto max-w-5xl px-4 py-24 sm:py-32">
      <!-- prettier-ignore -->
      <p class="font-mono text-sm text-muted"><span class="text-accent">~</span> <span class="text-muted">$</span> whoami<span aria-hidden="true" class="animate-blink text-accent">█</span></p>
      <h1 class="sr-only">Manuel Casinos Pérez</h1>
      <div class="mt-6">
        <AsciiName lines={["MANUEL", "CASINOS"]} />
      </div>
      <p class="mt-8 max-w-xl text-lg text-foreground">
        Desarrollador full stack en Valencia.
      </p>
      <p class="mt-2 font-mono text-sm text-accent-2">
        Java · Spring Boot · Angular · TypeScript · React
      </p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a
          href="#proyectos"
          class="inline-flex items-center gap-2 bg-accent px-5 py-3 font-mono text-sm font-medium text-background transition hover:bg-foreground"
        >
          <span aria-hidden="true">$</span> ls proyectos
        </a>
        <a
          href={profile.cvUrl ? "#cv" : "#contacto"}
          class="term-select inline-flex items-center gap-2 border border-accent/50 px-5 py-3 font-mono text-sm text-accent"
        >
          <span aria-hidden="true">$</span>
          {profile.cvUrl ? "cat cv.pdf" : "cd contacto"}
        </a>
      </div>
    </div>
    <AsciiSeam />
  </section>

  <Section id="sobre-mi" title="Sobre mí" command="cat perfil">
    <div
      data-reveal
      class="grid items-start gap-x-10 gap-y-6 sm:grid-cols-[auto_1fr]"
    >
      <pre
        aria-hidden="true"
        class="hidden font-mono text-[9px] leading-[1.1] text-accent select-none min-[420px]:block lg:text-[11px]"
      >{portrait}</pre>
      <div>
        <!-- prettier-ignore -->
        <p class="font-mono text-sm"><span class="text-accent">manuel</span><span class="text-muted">@</span><span class="text-accent">portfolio</span></p>
        <p aria-hidden="true" class="font-mono text-sm text-border select-none">
          ──────────────────
        </p>
        <dl class="mt-3 grid gap-x-8 gap-y-2 font-mono text-sm sm:grid-cols-[9rem_1fr] sm:text-base">
          {profile.about.map((row) => (
            <Fragment>
              <dt class="text-accent-2">{row.key}</dt>
              <dd class="text-foreground">{row.value}</dd>
            </Fragment>
          ))}
        </dl>
        <p class="mt-6 max-w-xl text-muted">{profile.aboutNote}</p>
        <p aria-hidden="true" class="mt-6 flex gap-1 font-mono select-none">
          {swatches.map((color) => (
            <span class={color}>███</span>
          ))}
        </p>
      </div>
    </div>
  </Section>

  <Section id="proyectos" title="Proyectos" command="ls -l">
    <ul class="border-t border-border">
      {projects.map((project) => (
        <ProjectEntry project={project} />
      ))}
    </ul>
  </Section>

  <Section id="stack" title="Stack" command="stack --list">
    <div data-reveal class="grid gap-10 font-mono text-sm sm:grid-cols-2">
      <div>
        <h3 class="text-accent">--base</h3>
        <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-2">
          {techStack.base.map((tech) => (
            <li class="text-foreground">
              <span aria-hidden="true" class="text-accent">
                ▸{" "}
              </span>
              {tech}
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="text-accent-2">--aprendiendo</h3>
        <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-2">
          {techStack.learning.map((tech) => (
            <li class="text-muted">
              <span aria-hidden="true" class="text-accent-2">
                ○{" "}
              </span>
              {tech}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  {profile.cvUrl && (
    <Section id="cv" title="Currículum" command="open curriculum.pdf">
      <div data-reveal>
        <div class="overflow-hidden border border-border bg-surface/80">
          <object
            data={profile.cvUrl}
            type="application/pdf"
            class="h-[80vh] w-full"
            aria-label={`Currículum de ${profile.name} en PDF`}
          >
            <p class="p-6 text-muted">
              Tu navegador no puede mostrar el PDF aquí.{" "}
              <a href={profile.cvUrl} class="text-accent underline">
                Ábrelo o descárgalo
              </a>
              .
            </p>
          </object>
        </div>
        <a
          href={profile.cvUrl}
          download
          class="term-select mt-4 inline-flex items-center gap-2 border border-accent/50 px-5 py-3 font-mono text-sm text-accent"
        >
          <span aria-hidden="true">↓</span> descargar PDF
        </a>
      </div>
    </Section>
  )}

  <Section id="contacto" title="Contacto" command="ping manuel">
    <ul data-reveal class="border-t border-border font-mono">
      {contactLinks.map((link) => (
        <li class="border-b border-border">
          <a
            href={link.href}
            {...(link.external
              ? { target: "_blank", rel: "noopener noreferrer" }
              : {})}
            class="term-select flex flex-wrap items-baseline gap-x-6 gap-y-1 px-1 py-4 sm:px-4"
          >
            <span class="w-36 text-sm text-muted">
              <span class="text-accent-2">$</span> {link.command}
            </span>
            <span class="text-accent [overflow-wrap:anywhere]">
              {link.label}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <script>
    import { initReveal } from "@/scripts/reveal";
    // La entrada del inicio la hacen las partículas del nombre; aquí solo las secciones.
    initReveal();
  </script>
</Layout>
