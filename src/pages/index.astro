---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
import { Button } from "@/components/ui/button";
---

<Layout
  title="Manuel Casinos Pérez · Portfolio"
  description="Portfolio de Manuel Casinos Pérez, desarrollador FullStack en Valencia: proyectos, stack y contacto."
  image="/og-default.jpg"
  url="/"
>
  <section id="inicio" class="mx-auto max-w-5xl scroll-mt-24 px-4 py-32">
    <p class="font-mono text-sm text-accent hero-element">Portfolio</p>
    <h1 class="mt-4 text-5xl font-bold tracking-tight hero-element">Manuel Casinos Pérez</h1>
    <p class="mt-6 max-w-xl text-lg text-muted hero-element">
      Desarrollador FullStack en Valencia. Creo aplicaciones web modernas,
      accesibles y performantes.
    </p>
    <div class="mt-8 flex flex-wrap gap-4 hero-element">
      <Button asChild className="w-full sm:w-auto">
        <a href="#proyectos">Ver proyectos</a>
      </Button>
      <a
        href="#contacto"
        class="rounded-lg border border-border px-6 py-3 text-sm font-medium text-foreground hover:bg-surface transition-colors"
      >
        Contactar
      </a>
    </div>
  </section>

  <Section id="sobre-mi" title="Sobre mí">
    <div class="space-y-4 text-muted animate-fade-up">
      <p>
        Desarrollador FullStack autodidacta con base en{" "}
        <strong>JavaScript/TypeScript</strong>,<strong>React</strong> y{" "}
        <strong>Node.js</strong>. Me interesa la arquitectura limpia, el
        rendimiento web y la experiencia de desarrollador.
      </p>
      <p>
        Aprendí programando proyectos reales: <em>Cerrajería NOA</em> (web
        corporativa),
        <em>Digital Fit 2.0</em> (plataforma de entrenamiento) y{" "}
        <em>ValveDex</em>
        (visualizador 3D de válvulas industriales con Three.js).
      </p>
      <p>
        Actualmente profundizando en <strong>Astro</strong>,{" "}
        <strong>bases de datos</strong>y <strong>testing automatizado</strong>.
        Busco oportunidades para seguir creciendo en entornos que valoren la
        calidad del código y el aprendizaje continuo.
      </p>
    </div>
  </Section>
  <Section id="proyectos" title="Proyectos">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 project-cards-container">
      {projects.map((project) => (
        <ProjectCard project={project} className="project-card" />
      ))}
    </div>
  </Section>
  <Section id="tecnologias" title="Tecnologías">
    <div class="space-y-12 animate-fade-up">
      <div>
        <h3 class="font-mono text-sm text-accent mb-4">Base sólida</h3>
        <div class="flex flex-wrap gap-2">
          {[
            "TypeScript",
            "React",
            "Node.js",
            "Astro",
            "Tailwind CSS",
            "Git",
            "PostgreSQL",
            "REST APIs",
          ].map((tech) => (
            <span class="px-3 py-1 text-sm font-mono rounded bg-surface border border-border">
              {tech}
            </span>
          ))}
        </div>
      </div>
      <div>
        <h3 class="font-mono text-sm text-accent mb-4">Aprendiendo</h3>
        <div class="flex flex-wrap gap-2">
          {[
            "Three.js / R3F",
            "Testing (Vitest/Playwright)",
            "Docker",
            "CI/CD",
            "GraphQL",
            "Next.js",
          ].map((tech) => (
            <span class="px-3 py-1 text-sm font-mono rounded bg-surface border border-border opacity-70">
              {tech}
            </span>
          ))}
        </div>
      </div>
    </div>
  </Section>
  <Section id="contacto" title="Contacto">
    <div class="space-y-4 text-muted animate-fade-up">
      <p>¿Tienes un proyecto en mente o quieres charlar? Escríbeme por aquí:</p>
      <ul class="space-y-3 text-base" role="list">
        <li>
          <a
            href="https://github.com/Manuelklk03"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 text-accent hover:underline group"
          >
            <svg
              class="w-5 h-5 transition-transform group-hover:translate-x-1"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z" />
            </svg>
            <span>GitHub</span>
          </a>
        </li>
        <li>
          <a
            href="https://www.linkedin.com/in/manuel-casinos-perez/"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 text-accent hover:underline group"
          >
            <svg
              class="w-5 h-5 transition-transform group-hover:translate-x-1"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063 2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
            </svg>
            <span>LinkedIn</span>
          </a>
        </li>
        <li>
          <a
            href="mailto:tu-email@ejemplo.com"
            class="flex items-center gap-3 text-accent hover:underline group"
          >
            <svg
              class="w-5 h-5 transition-transform group-hover:translate-x-1"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              />
            </svg>
            <span>Email (pendiente)</span>
          </a>
        </li>
      </ul>
    </div>
  </Section>
  <script type="module">
    import { animateHero, animateFadeUp, animateProjectCards } from "@/scripts/animations"
    animateHero("#inicio")
    animateFadeUp("#sobre-mi")
    animateFadeUp("#tecnologias")
    animateFadeUp("#contacto")
    animateProjectCards("#proyectos")
  </script>
</Layout>
