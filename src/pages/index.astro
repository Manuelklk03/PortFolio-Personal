---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
---

<Layout
  title="Manuel Casinos Pérez · Portfolio"
  description="Portfolio de Manuel Casinos Pérez, desarrollador FullStack en Valencia: proyectos, stack y contacto."
>
  <section id="inicio" class="mx-auto max-w-5xl scroll-mt-24 px-4 py-32">
    <p class="font-mono text-sm text-accent">Portfolio</p>
    <h1 class="mt-4 text-5xl font-bold tracking-tight">Manuel Casinos Pérez</h1>
    <p class="mt-6 max-w-xl text-lg text-muted">
      Desarrollador FullStack en Valencia.
    </p>
  </section>

  <Section id="sobre-mi" title="Sobre mí">
    <p class="text-muted">En preparación.</p>
  </Section>
  <Section id="proyectos" title="Proyectos">
    <p class="text-muted">En preparación.</p>
  </Section>
  <Section id="tecnologias" title="Tecnologías">
    <p class="text-muted">En preparación.</p>
  </Section>
  <Section id="contacto" title="Contacto">
    <p class="text-muted">En preparación.</p>
  </Section>
</Layout>
