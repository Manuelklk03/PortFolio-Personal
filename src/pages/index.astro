---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import ProjectEntry from "../components/ProjectEntry.astro";
import Cursor from "../components/Cursor.astro";
import CvPreview from "../components/CvPreview.astro";
import Terminal from "../components/Terminal.astro";
import ContactMail from "../components/ContactMail.astro";
import TechTile from "../components/TechTile.astro";
import AsciiScene from "../components/ascii/AsciiScene.astro";
import AsciiName from "../components/ascii/AsciiName.astro";
import AsciiSeam from "../components/ascii/AsciiSeam.astro";
import { blockLetters, imageAscii, tintedPhoto } from "../lib/ascii-art";
import { projects } from "../data/projects";
import { profile } from "../data/profile";
import { techStack } from "../data/tech";

// Retrato de Manuel para «Sobre mí», al estilo de neofetch (se genera al compilar):
// primero se ve en ASCII y la foto se monta encima fila a fila. Sin foto, sus iniciales.
// 42 filas: con caracteres de ancho 0,6 y alto 1,1 el bloque tiene la misma proporción que el recorte.
const portraitCrop = { left: 0.02, top: 0.04, width: 0.96, height: 0.76 };
const portraitAscii = await imageAscii(
  "src/assets/portrait.jpg",
  64,
  42,
  portraitCrop,
);
const portraitPhoto = await tintedPhoto(
  "src/assets/portrait.jpg",
  420,
  portraitCrop,
);
const portrait = portraitAscii ?? blockLetters("MC");
// Muestras de la paleta del tema activo: al hacer clic se copia el color (easter egg).
const swatches = [
  "surface",
  "border",
  "muted",
  "accent-2",
  "accent",
  "foreground",
];

// Datos para la terminal escribible.
const statusText = {
  completed: "completado",
  "in-progress": "en desarrollo",
  planned: "planificado",
} as const;
const terminalData = {
  name: profile.name,
  role: "Desarrollador full stack en Valencia",
  email: profile.email,
  github: profile.github,
  linkedin: profile.linkedin,
  cvUrl: profile.cvUrl,
  about: profile.about,
  stack: techStack,
  projects: projects.map((project) => ({
    id: project.id,
    title: project.title,
    status: statusText[project.status],
    description: project.description,
  })),
  sections: [
    "sobre-mi",
    "proyectos",
    "stack",
    "terminal",
    ...(profile.cvUrl ? ["cv"] : []),
    "contacto",
  ],
};

const contactLinks = [
  {
    command: "mail",
    label: profile.email,
    href: `mailto:${profile.email}`,
    external: false,
  },
  {
    command: "open github",
    label: "github.com/Manuelklk03",
    href: profile.github,
    external: true,
  },
  {
    command: "open linkedin",
    label: "in/manuel-casinos-perez",
    href: profile.linkedin,
    external: true,
  },
];
---

<Layout
  title="Manuel Casinos Pérez · Portfolio"
  description="Portfolio de Manuel Casinos Pérez, desarrollador FullStack en Valencia: proyectos, stack y contacto."
  image="/og-default.jpg"
  url="/"
>
  <Cursor />

  <section id="inicio" class="relative isolate scroll-mt-20 overflow-hidden">
    <AsciiScene />
    <div class="mx-auto max-w-5xl px-4 py-20 sm:py-24">
      <!-- prettier-ignore -->
      <p class="font-mono text-sm text-muted"><span class="text-accent">~</span> <span class="text-muted">$</span> whoami<span aria-hidden="true" class="animate-blink text-accent">█</span></p>
      <h1 class="sr-only">Manuel Casinos Pérez</h1>
      <div class="mt-6">
        <AsciiName lines={["MANUEL", "CASINOS"]} />
      </div>
      <p class="mt-8 max-w-xl text-lg text-foreground">
        Desarrollador full stack en Valencia.
      </p>
      <p class="mt-2 font-mono text-sm text-accent-2">
        Java · Spring Boot · Angular · TypeScript · React · Next.js
      </p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a
          href="#proyectos"
          class="inline-flex items-center gap-2 bg-accent px-5 py-3 font-mono text-sm font-medium text-background transition hover:bg-foreground"
        >
          <span aria-hidden="true">$</span> ls proyectos
        </a>
        <a
          href={profile.cvUrl ? "#cv" : "#contacto"}
          class="term-select inline-flex items-center gap-2 border border-accent/50 px-5 py-3 font-mono text-sm text-accent"
        >
          <span aria-hidden="true">$</span>{" "}
          {profile.cvUrl ? "cat cv.pdf" : "cd contacto"}
        </a>
      </div>
    </div>
    <AsciiSeam />
  </section>

  <Section id="sobre-mi" title="Sobre mí" command="cat perfil">
    <div
      data-reveal
      class="grid items-start gap-x-10 gap-y-6 sm:grid-cols-[auto_1fr]"
    >
      <div data-portrait class="relative w-fit">
        <pre
          aria-hidden="true"
          class="font-mono text-[8px] leading-[1.1] text-accent select-none sm:text-[9px] lg:text-[10px]"
        >{portrait}</pre>
        {portraitAscii && portraitPhoto && (
          <img
            src={portraitPhoto}
            alt="Foto de Manuel Casinos Pérez"
            class="absolute inset-0 h-full w-full [mask-image:radial-gradient(ellipse_58%_58%_at_50%_42%,#000_70%,transparent_100%)]"
          />
        )}
      </div>
      <div>
        <!-- prettier-ignore -->
        <p class="font-mono text-sm"><span class="text-accent">manuel</span><span class="text-muted">@</span><span class="text-accent">portfolio</span></p>
        <p aria-hidden="true" class="font-mono text-sm text-border select-none">
          ──────────────────
        </p>
        <dl class="mt-3 grid gap-x-8 gap-y-2 font-mono text-sm sm:grid-cols-[9rem_1fr] sm:text-base">
          {profile.about.map((row) => (
            <Fragment>
              <dt class="text-accent-2">{row.key}</dt>
              <dd class="text-foreground">{row.value}</dd>
            </Fragment>
          ))}
        </dl>
        <p class="mt-6 max-w-xl text-muted">{profile.aboutNote}</p>
        <p class="mt-6 flex gap-1 font-mono select-none">
          {swatches.map((name) => (
            <button
              type="button"
              data-copy-color={`--color-${name}`}
              aria-label={`Copiar el color ${name} del tema`}
              title={name}
              style={`color: var(--color-${name})`}
              class="transition-transform hover:-translate-y-0.5"
            >
              ███
            </button>
          ))}
        </p>
      </div>
    </div>
  </Section>

  <Section id="proyectos" title="Proyectos" command="ls -l">
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => (
        <ProjectEntry project={project} />
      ))}
    </ul>
  </Section>

  <Section id="stack" title="Stack" command="stack --list">
    <div data-reveal class="grid gap-10 font-mono text-sm lg:grid-cols-[2fr_1fr]">
      <div>
        <h3 class="text-accent">--base</h3>
        <ul class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-6">
          {techStack.base.map((tech, index) => (
            <TechTile name={tech} index={index} />
          ))}
        </ul>
      </div>
      <div>
        <h3 class="text-accent-2">--aprendiendo</h3>
        <ul class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-6 lg:grid-cols-3">
          {techStack.learning.map((tech, index) => (
            <TechTile
              name={tech}
              index={index + techStack.base.length}
              learning
            />
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <Section id="terminal" title="Terminal" command="bash">
    <div data-reveal class="max-w-3xl">
      <Terminal data={terminalData} />
    </div>
  </Section>

  {profile.cvUrl && (
    <Section id="cv" title="Currículum" command="open curriculum.pdf">
      <div data-reveal class="max-w-3xl">
        <CvPreview url={profile.cvUrl} name={profile.name} />
      </div>
    </Section>
  )}

  <Section id="contacto" title="Contacto" command="ping manuel">
    <div data-reveal class="grid gap-8 lg:grid-cols-[1fr_20rem]">
      <ContactMail email={profile.email} />
      <ul class="self-start border-t border-border font-mono">
        {contactLinks.map((link) => (
          <li class="border-b border-border">
            <a
              href={link.href}
              {...(link.external
                ? { target: "_blank", rel: "noopener noreferrer" }
                : {})}
              class="term-select flex flex-col gap-1 px-1 py-4 sm:px-4"
            >
              <span class="w-36 text-sm text-muted">
                <span class="text-accent-2">$</span> {link.command}
              </span>
              <span class="text-accent [overflow-wrap:anywhere]">
                {link.label}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <!-- Mensajes breves de los easter eggs -->
  <p
    data-toast
    role="status"
    class="pointer-events-none fixed bottom-6 left-1/2 z-50 -translate-x-1/2 border border-accent/50 bg-background px-4 py-2 font-mono text-sm text-accent opacity-0 transition-opacity duration-300"
  ></p>

  <script>
    import { initReveal } from "@/scripts/reveal";
    import { initScramble } from "@/scripts/scramble";
    import { initEasterEggs } from "@/scripts/easter-eggs";
    import { initPortraitMosaic } from "@/scripts/portrait-mosaic";
    initScramble();
    initEasterEggs();
    const portraitRoot = document.querySelector<HTMLElement>("[data-portrait]");
    if (portraitRoot) initPortraitMosaic(portraitRoot);
    // La entrada del inicio la hacen las partículas del nombre; aquí solo las secciones.
    initReveal();
  </script>
</Layout>
