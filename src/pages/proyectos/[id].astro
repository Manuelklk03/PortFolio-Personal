---
// Página de detalle de un proyecto: portada, texto a la izquierda y ficha fija a la derecha.
// Astro genera una por proyecto al compilar (getStaticPaths).
import Layout from "@/layouts/Layout.astro";
import TechTile from "@/components/TechTile.astro";
import { blockLetters } from "@/lib/ascii-art";
import { projects } from "@/data/projects";
import type { Project } from "@/data/projects";
import { statusLabel, statusColor } from "@/lib/project-status";
import { projectSchema } from "@/lib/schema";

// Cada página recibe también el proyecto anterior y el siguiente (circular).
export function getStaticPaths() {
  return projects.map((project, index) => ({
    params: { id: project.id },
    props: {
      project,
      previous: projects[(index - 1 + projects.length) % projects.length],
      next: projects[(index + 1) % projects.length],
    },
  }));
}

interface Props {
  project: Project;
  previous: Project | undefined;
  next: Project | undefined;
}

const { project, previous, next } = Astro.props;

const signature = blockLetters(project.monogram);
const jsonLd = projectSchema(project, Astro.site);

const permissions: Record<Project["status"], string> = {
  completed: "drwxr-xr-x",
  "in-progress": "drwxr-x---",
  planned: "d---------",
};

const links = [
  ...(project.repo ? [{ label: "Ver código", href: project.repo }] : []),
  ...(project.demo ? [{ label: "Ver web", href: project.demo }] : []),
];

const neighbours = [
  ...(previous && previous.id !== project.id
    ? [{ project: previous, label: "anterior", arrow: "←", align: "" }]
    : []),
  ...(next && next.id !== project.id
    ? [{ project: next, label: "siguiente", arrow: "→", align: "sm:text-right" }]
    : []),
];
---

<Layout
  title={`${project.title} · Manuel Casinos Pérez`}
  description={project.description}
  image={project.ogImage ?? "/og-default.jpg"}
  imageAlt={project.ogImage ? `Captura de ${project.title}` : undefined}
  url={`/proyectos/${project.id}`}
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-5xl px-4 py-12 font-mono sm:py-16">
    <a
      href="/#proyectos"
      class="term-select -mx-1 inline-flex min-h-11 items-center px-1 text-sm text-accent sm:min-h-0"
    >
      <span aria-hidden="true">←</span>&nbsp;cd ..
      <span class="sr-only">Volver a proyectos</span>
    </a>

    <!-- Portada: la captura, o la firma ASCII del proyecto en grande. -->
    <header
      data-reveal
      class="relative mt-6 overflow-hidden border border-border bg-surface/60"
    >
      <div class="relative flex aspect-[16/9] items-center justify-center sm:aspect-[21/9]">
        {
          project.image ? (
            <img
              src={project.image}
              alt={`Captura de ${project.title}`}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="absolute inset-0 h-full w-full object-cover object-top"
            />
          ) : (
            <pre
              aria-hidden="true"
              class="pb-16 font-mono text-[clamp(9px,2.4vw,20px)] leading-none text-accent select-none"
            >{signature}</pre>
          )
        }
        <div
          aria-hidden="true"
          class="absolute inset-0 bg-gradient-to-t from-background from-20% via-background/85 via-45% to-transparent"
        >
        </div>
        <div class="absolute inset-x-0 bottom-0 p-5 sm:p-8">
          <p aria-hidden="true" class="text-sm text-muted">
            $ cd proyectos/<span class="text-accent-2">{project.id}</span>
          </p>
          <h1
            class="mt-2 text-3xl font-semibold tracking-tight text-foreground sm:text-5xl"
          >
            {project.title}
          </h1>
        </div>
      </div>
    </header>

    <div class="mt-10 grid gap-10 lg:grid-cols-[1fr_20rem]">
      <div class="min-w-0">
        <p data-reveal class="max-w-2xl font-sans text-lg leading-relaxed text-foreground/90">
          {project.description}
        </p>

        {
          project.features && project.features.length > 0 && (
            <section data-reveal aria-labelledby="features-title" class="mt-12">
              <h2 id="features-title" class="text-sm text-accent-2">
                {project.status === "completed" ? "$ ls funcionalidades/" : "$ ls alcance-previsto/"}
              </h2>
              <ul class="mt-4 grid gap-3 sm:grid-cols-2">
                {project.features.map((feature, index) => (
                  <li class="flex gap-3 border border-border bg-surface/40 p-4 font-sans text-sm leading-snug text-muted">
                    <span
                      aria-hidden="true"
                      class="font-mono text-xs text-accent"
                    >
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    {feature}
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <section data-reveal aria-labelledby="role-title" class="mt-12">
          <h2 id="role-title" class="text-sm text-accent-2">$ cat aportación</h2>
          <p class="mt-4 max-w-2xl border-l-2 border-accent/60 pl-4 font-sans text-base leading-relaxed text-muted">
            {project.personalContribution}
          </p>
        </section>
      </div>

      <!-- Ficha: se queda a la vista mientras se lee el texto. -->
      <aside
        data-reveal
        aria-label="Ficha del proyecto"
        class="h-fit border border-border bg-surface/60 p-5 lg:sticky lg:top-24"
      >
        <p aria-hidden="true" class="text-xs text-muted">
          {permissions[project.status]}
        </p>
        <p class="mt-1 flex gap-2 text-sm">
          <span class="text-muted">estado</span>
          <span class={statusColor[project.status]}>
            [{statusLabel[project.status]}]
          </span>
        </p>

        <h2 id="stack-title" class="mt-6 text-sm text-accent-2">$ cat stack</h2>
        <ul class="mt-3 grid grid-cols-3 gap-2">
          {
            project.technologies.map((tech, index) => (
              <TechTile name={tech} {index} compact />
            ))
          }
        </ul>

        {
          links.length > 0 && (
            <ul class="mt-6 grid gap-2 text-sm">
              {links.map((link, index) => (
                <li>
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={
                      index === 0
                        ? "flex min-h-11 items-center justify-between bg-accent px-4 py-2 font-medium text-background transition hover:bg-foreground"
                        : "term-select flex min-h-11 items-center justify-between border border-accent/50 px-4 py-2 text-accent"
                    }
                  >
                    {link.label}
                    <span aria-hidden="true">↗</span>
                    <span class="sr-only">de {project.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </aside>
    </div>

    {
      neighbours.length > 0 && (
        <nav
          data-reveal
          aria-label="Otros proyectos"
          class="mt-16 grid gap-3 border-t border-border pt-8 sm:grid-cols-2"
        >
          {neighbours.map((item) => (
            <a
              href={`/proyectos/${item.project.id}`}
              class={`term-select block border border-border p-4 ${item.align}`}
            >
              <span class="text-xs text-muted">
                {item.arrow === "←" && <span aria-hidden="true">← </span>}
                {item.label}
                {item.arrow === "→" && <span aria-hidden="true"> →</span>}
              </span>
              <span class="mt-1 block text-lg text-foreground">
                {item.project.title}
              </span>
            </a>
          ))}
        </nav>
      )
    }
  </article>
</Layout>

<script>
  import { initReveal } from "@/scripts/reveal";
  initReveal();
</script>
