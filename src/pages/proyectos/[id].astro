---
import Layout from "@/layouts/Layout.astro";
import { blockLetters } from "@/lib/ascii-art";
import { projects } from "@/data/projects";
import type { Project } from "@/data/projects";
import { statusLabel, statusColor } from "@/lib/project-status";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;

const signature = blockLetters(project.monogram);

const links = [
  ...(project.repo ? [{ label: "Código", href: project.repo }] : []),
  ...(project.demo ? [{ label: "Demo", href: project.demo }] : []),
];
---

<Layout
  title={`${project.title} · Manuel Casinos Pérez`}
  description={project.description}
  image={project.image ?? "/og-default.jpg"}
  url={`/proyectos/${project.id}`}
>
  <article class="mx-auto max-w-5xl px-4 py-16 font-mono sm:py-20">
    <a
      href="/#proyectos"
      class="term-select -mx-1 inline-flex min-h-11 items-center px-1 text-sm text-accent sm:min-h-0"
    >
      <span aria-hidden="true">←</span>&nbsp;cd ..
      <span class="sr-only">Volver a proyectos</span>
    </a>

    <p aria-hidden="true" class="mt-8 text-sm text-muted">
      $ cd proyectos/<span class="text-accent-2">{project.id}</span>
    </p>
    <header class="mt-4 grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
          {project.title}
        </h1>
        <p class="mt-3 text-sm">
          <span class={statusColor[project.status]}>
            [{statusLabel[project.status]}]
          </span>
        </p>
      </div>
      <!-- Firma en letras de bloque, generada al compilar. -->
      <pre
        aria-hidden="true"
        class="font-mono text-[7px] leading-none text-accent select-none sm:text-[9px]"
      >{signature}</pre>
    </header>

    <p class="mt-8 max-w-2xl font-sans text-lg text-muted">
      {project.description}
    </p>

    {project.image && (
      <div class="mt-10 overflow-hidden border border-border">
        <img
          src={project.image}
          alt={`Captura de ${project.title}`}
          class="aspect-video w-full object-cover"
        />
      </div>
    )}

    <div class="mt-12 grid gap-10 text-sm sm:grid-cols-2">
      <section aria-labelledby="stack-title">
        <h2 id="stack-title" class="text-accent-2">
          $ cat stack
        </h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {project.technologies.map((tech) => (
            <li class="border border-border px-3 py-1 text-foreground">
              {tech}
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="role-title">
        <h2 id="role-title" class="text-accent-2">
          $ cat aportación
        </h2>
        <p class="mt-3 font-sans text-base text-muted">
          {project.personalContribution}
        </p>
      </section>
    </div>

    {project.features && project.features.length > 0 && (
      <section aria-labelledby="features-title" class="mt-12 text-sm">
        <h2 id="features-title" class="text-accent-2">
          $ ls funcionalidades/
        </h2>
        <ul class="mt-3 border-t border-border">
          {project.features.map((feature) => (
            <li class="flex gap-3 border-b border-border py-3 font-sans text-base text-muted">
              <span aria-hidden="true" class="font-mono text-accent">
                &gt;
              </span>
              {feature}
            </li>
          ))}
        </ul>
      </section>
    )}

    {links.length > 0 && (
      <ul class="mt-12 flex flex-wrap gap-5 text-sm">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="term-select -mx-1 inline-flex min-h-11 items-center gap-1 px-1 text-accent sm:min-h-0"
            >
              <span aria-hidden="true">↗</span> {link.label}
              <span class="sr-only">de {project.title}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </article>
</Layout>
