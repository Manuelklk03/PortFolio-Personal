---
import { profile } from "../data/profile";

// El enlace al CV solo aparece cuando hay PDF.
const links = [
  { href: "#sobre-mi", label: "Sobre mí" },
  { href: "#proyectos", label: "Proyectos" },
  { href: "#tecnologias", label: "Tecnologías" },
  ...(profile.cvUrl ? [{ href: "#cv", label: "CV" }] : []),
  { href: "#contacto", label: "Contacto" },
];
---

<!-- En móvil no es fija: ocuparía demasiada pantalla y taparía los títulos. -->
<header class="z-10 border-b border-border bg-background/80 backdrop-blur sm:sticky sm:top-0">
  <nav
    aria-label="Principal"
    class="mx-auto flex max-w-5xl flex-col gap-2 px-4 py-4 sm:flex-row sm:items-center sm:justify-between"
  >
    <a
      href="#inicio"
      class="font-mono text-sm"
      aria-label="Manuel Casinos Pérez, ir al inicio"
    >
      <!-- prettier-ignore -->
      <span class="text-accent">manuel</span><span class="text-muted">@portfolio:</span><span class="text-accent-2">~</span><span class="text-muted">$</span><span aria-hidden="true" class="animate-blink text-accent">_</span>
    </a>
    <ul class="flex flex-wrap gap-x-5 font-mono text-sm text-muted">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="inline-flex min-h-11 items-center transition-colors hover:text-accent sm:min-h-0"
          >
            <!-- prettier-ignore -->
            <span aria-hidden="true" class="text-accent-2">./</span>{link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
