---
import { profile } from "../data/profile";

// El enlace al CV solo aparece cuando hay PDF.
const links = [
  { href: "#sobre-mi", label: "Sobre mí" },
  { href: "#proyectos", label: "Proyectos" },
  { href: "#stack", label: "Stack" },
  ...(profile.cvUrl ? [{ href: "#cv", label: "CV" }] : []),
  { href: "#contacto", label: "Contacto" },
];
---

<!-- En móvil no es fija: ocuparía demasiada pantalla y taparía los títulos. -->
<header class="z-10 border-b border-border bg-background/80 backdrop-blur sm:sticky sm:top-0">
  <nav
    aria-label="Principal"
    class="mx-auto flex max-w-5xl flex-col gap-2 px-4 py-4 sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="flex items-center gap-6">
      <a
        href="#inicio"
        class="term-select -mx-1 px-1 font-mono text-sm"
        aria-label="Manuel Casinos Pérez, ir al inicio"
      >
        <!-- prettier-ignore -->
        <span><span class="text-accent">manuel</span><span class="text-muted">@portfolio:</span><span data-prompt-path class="text-accent-2">~</span><span class="text-muted">$</span><span aria-hidden="true" class="animate-blink text-accent">_</span></span>
      </a>
      <!-- Progreso de lectura: se llena al bajar (solo escritorio y navegadores compatibles). -->
      <span
        aria-hidden="true"
        class="scroll-progress font-mono text-xs text-border max-lg:hidden!"
      >
        <span class="col-start-1 row-start-1">░░░░░░░░░░░░░░░░</span>
        <span data-fill class="col-start-1 row-start-1 text-accent">
          ████████████████
        </span>
      </span>
    </div>
    <ul class="flex flex-wrap gap-x-3 font-mono text-sm text-muted">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="term-select inline-flex min-h-11 items-center px-1.5 sm:min-h-0"
          >
            <!-- prettier-ignore -->
            <span><span aria-hidden="true" class="text-accent-2 max-sm:hidden">./</span>{link.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const path = document.querySelector<HTMLElement>("[data-prompt-path]");
  const sections = document.querySelectorAll<HTMLElement>("main section[id]");

  if (path && sections.length) {
    // La sección que cruza la mitad de la pantalla marca la ruta del prompt.
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const id = entry.target.id;
          path.textContent = id === "inicio" ? "~" : `~/${id}`;
        }
      },
      { rootMargin: "-45% 0px -50% 0px" },
    );
    sections.forEach((section) => observer.observe(section));
  }
</script>
