---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="scroll-mt-24 py-24">
  <div class="mx-auto max-w-5xl px-4">
    <h2 id={`${id}-title`} class="text 3xl font-semibold tracking-tight">
      {title}
    </h2>
    <div class="mt-6">
      <slot />
    </div>
  </div>
</section>
