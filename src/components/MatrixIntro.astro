---
// Diálogo de entrada: Morfeo ofrece la píldora roja (tema Matrix) o la azul (Abyss + Jade).
// Hasta que se elige, la web se ve en modo neutro. El estarcido de Morfeo lo generó Codex para Manuel
// (public/intro/morpheus.webp, con el negro convertido en transparencia para que se vea la lluvia).
// Centro de las píldoras del dibujo, medido sobre la imagen (en %).
const PILLS = {
  red: { x: 24.2, y: 54.2 },
  blue: { x: 75.5, y: 54.2 },
};
---

<dialog
  data-matrix-dialog
  aria-labelledby="matrix-title"
  tabindex="-1"
  class="fixed inset-0 z-50 outline-none m-0 h-full max-h-none w-full max-w-none overflow-y-auto border-none bg-[#020402] p-4 backdrop:bg-black open:flex open:flex-col open:items-center open:justify-center"
>
  <!-- Lluvia de código de Matrix detrás de Morfeo -->
  <canvas
    data-matrix-rain
    aria-hidden="true"
    class="pointer-events-none fixed inset-0 h-full w-full opacity-60"></canvas>

  <div
    class="relative mx-auto flex w-full max-w-3xl flex-col items-center border border-[#1f3a24] bg-black/70 p-4 font-mono backdrop-blur-sm sm:p-8"
  >
    <div
      class="mb-4 flex w-full items-center justify-between border-b border-[#1f3a24] pb-3 text-xs text-[#7fbf8a]"
    >
      <span>morpheus@matrix:~$ ./choose_pill.sh</span>
      <button
        type="button"
        data-pill-skip
        class="px-2 py-0.5 text-xs text-[#7fbf8a] hover:bg-[#d6ffe0] hover:text-black focus-visible:bg-[#d6ffe0] focus-visible:text-black"
      >
        [ omitir · Esc ]
      </button>
    </div>

    <h2 id="matrix-title" class="max-w-xl text-center text-sm text-[#d6ffe0] sm:text-base">
      «Esta es tu última oportunidad. Después de esto, no hay vuelta atrás.»
    </h2>
    <p class="mt-1 text-center text-xs text-[#7fbf8a] sm:text-xs">
      Elige una píldora para decidir cómo ves este portfolio.
    </p>

    <!-- Morfeo con una píldora en cada mano: caen a las palmas al abrir y flotan -->
    <div
      data-pill-stage
      class="relative my-3 w-full max-w-[17rem] select-none sm:max-w-[21rem]"
    >
      <img
        src="/intro/morpheus.webp"
        alt="Morfeo tendiendo las manos con una píldora roja y otra azul"
        width="640"
        height="787"
        fetchpriority="high"
        decoding="async"
        class="block h-auto w-full [filter:drop-shadow(0_0_10px_rgb(0_255_102/0.35))]"
      />
      <button
        type="button"
        data-pill-choice="matrix"
        tabindex="-1"
        aria-hidden="true"
        class="absolute -translate-x-1/2 -translate-y-1/2 p-2 text-[8px] sm:text-[10px]"
        style={`left:${PILLS.red.x}%; top:${PILLS.red.y}%`}
      >
        <span class="pill-motion pill-motion--red block" style="--pill-delay: 0.35s">
          <span class="pill pill--red -rotate-[24deg]"></span>
        </span>
      </button>
      <button
        type="button"
        data-pill-choice="abyss"
        tabindex="-1"
        aria-hidden="true"
        class="absolute -translate-x-1/2 -translate-y-1/2 p-2 text-[8px] sm:text-[10px]"
        style={`left:${PILLS.blue.x}%; top:${PILLS.blue.y}%`}
      >
        <span class="pill-motion pill-motion--blue block" style="--pill-delay: 0.6s">
          <span class="pill pill--blue rotate-[24deg]"></span>
        </span>
      </button>
    </div>

    <!-- Opciones con texto (las que usan el teclado y los lectores de pantalla) -->
    <div class="grid w-full max-w-lg grid-cols-1 gap-3 sm:grid-cols-2">
      <button
        type="button"
        data-pill-choice="matrix"
        class="group flex items-center gap-3 border border-red-500/50 px-4 py-3 text-left transition-colors hover:border-red-400 hover:bg-red-500/10 focus-visible:border-red-400 focus-visible:bg-red-500/10"
      >
        <span class="pill pill--red shrink-0 text-[13px]" aria-hidden="true"></span>
        <span>
          <span class="block font-bold tracking-wider text-red-300">píldora roja</span>
          <span class="block text-xs text-red-200/70">entra en la madriguera · la web en verde fósforo (Matrix)</span>
        </span>
      </button>
      <button
        type="button"
        data-pill-choice="abyss"
        class="group flex items-center gap-3 border border-sky-500/50 px-4 py-3 text-left transition-colors hover:border-sky-400 hover:bg-sky-500/10 focus-visible:border-sky-400 focus-visible:bg-sky-500/10"
      >
        <span class="pill pill--blue shrink-0 text-[13px]" aria-hidden="true"></span>
        <span>
          <span class="block font-bold tracking-wider text-sky-300">píldora azul</span>
          <span class="block text-xs text-sky-200/70">despierta en tu cama · la web en azul abismo y jade</span>
        </span>
      </button>
    </div>

    <p class="mt-5 text-center text-xs text-[#7fbf8a]">
      <kbd class="border border-[#1f3a24] px-1">R</kbd> roja ·
      <kbd class="border border-[#1f3a24] px-1">A</kbd> azul ·
      <kbd class="border border-[#1f3a24] px-1">Esc</kbd> omitir (tema azul)
    </p>
  </div>
  <div data-pill-flash aria-hidden="true" class="pill-flash"></div>
</dialog>
<div data-pill-flash-page aria-hidden="true" class="pill-flash"></div>

<script>
  import { applyTheme, getSavedTheme, type Theme } from "../scripts/theme";
  import { markIntroDone } from "../scripts/intro-gate";

  const dialog = document.querySelector<HTMLDialogElement>("[data-matrix-dialog]");
  const canvas = dialog?.querySelector<HTMLCanvasElement>("[data-matrix-rain]");
  const stage = dialog?.querySelector<HTMLElement>("[data-pill-stage]");
  const flash = dialog?.querySelector<HTMLElement>("[data-pill-flash]");
  const pageFlash = document.querySelector<HTMLElement>("[data-pill-flash-page]");
  const reducedMotion = () =>
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

  interface Rain {
    stop: () => void;
    setInterval: (ms: number) => void;
  }

  // Lluvia de caracteres: columnas que caen dejando una estela que se apaga.
  const startRain = (target: HTMLCanvasElement): Rain => {
    const ctx = target.getContext("2d");
    if (!ctx || reducedMotion()) return { stop: () => {}, setInterval: () => {} };

    const glyphs = "ｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄ0123456789<>/=+*#%@";
    const size = 16;
    let interval = 50;
    let drops: number[] = [];
    const resize = () => {
      target.width = window.innerWidth;
      target.height = window.innerHeight;
      drops = Array.from({ length: Math.ceil(target.width / size) }, () =>
        Math.floor(Math.random() * -40),
      );
    };
    resize();
    window.addEventListener("resize", resize);

    let frameId = 0;
    let last = 0;
    const tick = (now: number) => {
      frameId = requestAnimationFrame(tick);
      if (now - last < interval) return;
      last = now;
      ctx.fillStyle = "rgb(2 4 2 / 0.12)";
      ctx.fillRect(0, 0, target.width, target.height);
      ctx.font = `${size}px monospace`;
      drops.forEach((y, i) => {
        const char = glyphs[Math.floor(Math.random() * glyphs.length)] ?? "0";
        ctx.fillStyle = Math.random() > 0.96 ? "#d6ffe0" : "#00ff66";
        ctx.fillText(char, i * size, y * size);
        drops[i] = y * size > target.height && Math.random() > 0.975 ? 0 : y + 1;
      });
    };
    frameId = requestAnimationFrame(tick);
    return {
      stop: () => {
        cancelAnimationFrame(frameId);
        window.removeEventListener("resize", resize);
      },
      setInterval: (ms) => {
        interval = ms;
      },
    };
  };

  if (dialog && canvas && stage && flash && pageFlash) {
    let rain: Rain = { stop: () => {}, setInterval: () => {} };
    let choosing = false;

    const close = () => {
      rain.stop();
      dialog.close();
      document.body.classList.remove("overflow-hidden");
      markIntroDone();
    };

    const open = () => {
      if (dialog.open) return;
      choosing = false;
      delete stage.dataset.focus;
      delete stage.dataset.chosen;
      flash.classList.remove("is-on");
      // Reinicia la caída de las píldoras cada vez que se abre.
      stage.classList.remove("is-dropping");
      void stage.offsetWidth;
      stage.classList.add("is-dropping");
      dialog.showModal();
      document.body.classList.add("overflow-hidden");
      rain = startRain(canvas);
      // El foco empieza en el propio diálogo, no en una píldora: así ninguna aparece ya
      // seleccionada al entrar. Con teclado, Tab recorre «omitir» y las dos píldoras.
      dialog.focus();
    };

    // Elegir: la píldora crece, su color inunda la pantalla y el tema cambia por debajo.
    const choose = async (theme: Theme) => {
      if (choosing) return;
      choosing = true;
      if (reducedMotion()) {
        applyTheme(theme);
        close();
        return;
      }
      const color = theme === "matrix" ? "red" : "blue";
      stage.dataset.chosen = color;
      flash.dataset.color = color;
      pageFlash.dataset.color = color;
      if (theme === "matrix") rain.setInterval(12);
      await wait(380);
      flash.classList.add("is-on");
      await wait(420);
      pageFlash.classList.add("is-on");
      applyTheme(theme);
      close();
      await wait(60);
      pageFlash.classList.remove("is-on");
    };

    dialog.querySelectorAll<HTMLButtonElement>("[data-pill-choice]").forEach((button) => {
      const color = button.dataset.pillChoice === "matrix" ? "red" : "blue";
      // Al apuntar a una píldora (con ratón o teclado) la otra se atenúa.
      const focus = () => {
        if (!choosing) stage.dataset.focus = color;
      };
      const blur = () => {
        if (!choosing) delete stage.dataset.focus;
      };
      button.addEventListener("pointerenter", focus);
      button.addEventListener("focus", focus);
      button.addEventListener("pointerleave", blur);
      button.addEventListener("blur", blur);
      button.addEventListener("click", () =>
        choose(button.dataset.pillChoice === "matrix" ? "matrix" : "abyss"),
      );
    });

    // Omitir (botón o Esc) también elige: la píldora azul, el tema por defecto.
    dialog.querySelector("[data-pill-skip]")?.addEventListener("click", () => choose("abyss"));
    dialog.addEventListener("cancel", (event) => {
      event.preventDefault();
      choose("abyss");
    });

    window.addEventListener("keydown", (event) => {
      if (!dialog.open) return;
      const key = event.key.toLowerCase();
      if (key === "r") {
        event.preventDefault();
        choose("matrix");
      } else if (key === "a" || key === "b") {
        event.preventDefault();
        choose("abyss");
      }
    });

    // Se abre solo si todavía no se ha elegido ninguna píldora.
    if (!getSavedTheme()) setTimeout(open, 400);

    window.addEventListener("open-matrix-pill", open);
  }
</script>
