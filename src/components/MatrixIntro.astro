---
// Diálogo de entrada: Morfeo en ASCII ofrece la píldora roja (tema Matrix) o la azul (Abyss + Jade).
// Hasta que se elige, la web se ve en modo neutro. La silueta de Morfeo es un SVG propio.
import { MORPHEUS_SVG, PALMS } from "../lib/morpheus";
---

<dialog
  data-matrix-dialog
  aria-labelledby="matrix-title"
  class="fixed inset-0 z-50 m-0 h-full max-h-none w-full max-w-none overflow-y-auto border-none bg-[#020402] p-4 backdrop:bg-black open:flex open:flex-col open:items-center open:justify-center"
>
  <!-- Lluvia de código de Matrix detrás de Morfeo -->
  <canvas
    data-matrix-rain
    aria-hidden="true"
    class="pointer-events-none fixed inset-0 h-full w-full opacity-60"></canvas>

  <div
    class="relative mx-auto flex w-full max-w-3xl flex-col items-center border border-[#1f3a24] bg-black/70 p-4 font-mono backdrop-blur-sm sm:p-8"
  >
    <div
      class="mb-4 flex w-full items-center justify-between border-b border-[#1f3a24] pb-3 text-xs text-[#7fbf8a]"
    >
      <span>morpheus@matrix:~$ ./choose_pill.sh</span>
      <button
        type="button"
        data-pill-skip
        class="px-2 py-0.5 text-xs text-[#7fbf8a] hover:bg-[#d6ffe0] hover:text-black focus-visible:bg-[#d6ffe0] focus-visible:text-black"
      >
        [ omitir · Esc ]
      </button>
    </div>

    <h2 id="matrix-title" class="max-w-xl text-center text-sm text-[#d6ffe0] sm:text-base">
      «Esta es tu última oportunidad. Después de esto, no hay vuelta atrás.»
    </h2>
    <p class="mt-1 text-center text-[11px] text-[#7fbf8a] sm:text-xs">
      Elige una píldora para decidir cómo ves este portfolio.
    </p>

    <!-- Morfeo con una píldora en cada mano -->
    <div class="relative my-4 w-full max-w-lg select-none">
      <div aria-hidden="true" set:html={MORPHEUS_SVG} />
      <button
        type="button"
        data-pill-choice="matrix"
        tabindex="-1"
        aria-hidden="true"
        class="pill-float absolute -translate-x-1/2 -translate-y-full text-[11px] sm:text-[15px]"
        style={`left:${PALMS.left.x}%; top:${PALMS.left.y}%`}
      >
        <span class="pill pill--red -rotate-12"></span>
      </button>
      <button
        type="button"
        data-pill-choice="abyss"
        tabindex="-1"
        aria-hidden="true"
        class="pill-float absolute -translate-x-1/2 -translate-y-full text-[11px] sm:text-[15px] [animation-delay:-1.4s]"
        style={`left:${PALMS.right.x}%; top:${PALMS.right.y}%`}
      >
        <span class="pill pill--blue rotate-12"></span>
      </button>
    </div>

    <!-- Opciones con texto (las que usan el teclado y los lectores de pantalla) -->
    <div class="grid w-full max-w-lg grid-cols-1 gap-3 sm:grid-cols-2">
      <button
        type="button"
        data-pill-choice="matrix"
        class="group flex items-center gap-3 border border-red-500/50 px-4 py-3 text-left transition-colors hover:border-red-400 hover:bg-red-500/10 focus-visible:border-red-400 focus-visible:bg-red-500/10"
      >
        <span class="pill pill--red shrink-0 text-[13px]" aria-hidden="true"></span>
        <span>
          <span class="block font-bold tracking-wider text-red-300">píldora roja</span>
          <span class="block text-[11px] text-red-200/70">ver hasta dónde llega la madriguera · tema Matrix</span>
        </span>
      </button>
      <button
        type="button"
        data-pill-choice="abyss"
        class="group flex items-center gap-3 border border-sky-500/50 px-4 py-3 text-left transition-colors hover:border-sky-400 hover:bg-sky-500/10 focus-visible:border-sky-400 focus-visible:bg-sky-500/10"
      >
        <span class="pill pill--blue shrink-0 text-[13px]" aria-hidden="true"></span>
        <span>
          <span class="block font-bold tracking-wider text-sky-300">píldora azul</span>
          <span class="block text-[11px] text-sky-200/70">despertar en tu cama · tema Abyss + Jade</span>
        </span>
      </button>
    </div>

    <p class="mt-5 text-center text-[11px] text-[#7fbf8a]">
      <kbd class="border border-[#1f3a24] px-1">R</kbd> roja ·
      <kbd class="border border-[#1f3a24] px-1">A</kbd> azul ·
      <kbd class="border border-[#1f3a24] px-1">Esc</kbd> omitir (tema azul)
    </p>
  </div>
</dialog>

<script>
  import { applyTheme, getSavedTheme, type Theme } from "../scripts/theme";

  const dialog = document.querySelector<HTMLDialogElement>("[data-matrix-dialog]");
  const canvas = dialog?.querySelector<HTMLCanvasElement>("[data-matrix-rain]");

  // Lluvia de caracteres: columnas que caen dejando una estela que se apaga.
  const startRain = (target: HTMLCanvasElement) => {
    const ctx = target.getContext("2d");
    if (!ctx || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      return () => {};
    }
    const glyphs = "ｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄ0123456789<>/=+*#%@";
    const size = 16;
    let drops: number[] = [];
    const resize = () => {
      target.width = window.innerWidth;
      target.height = window.innerHeight;
      drops = Array.from({ length: Math.ceil(target.width / size) }, () =>
        Math.floor(Math.random() * -40),
      );
    };
    resize();
    window.addEventListener("resize", resize);

    let frameId = 0;
    let last = 0;
    const tick = (now: number) => {
      frameId = requestAnimationFrame(tick);
      if (now - last < 50) return;
      last = now;
      ctx.fillStyle = "rgb(2 4 2 / 0.12)";
      ctx.fillRect(0, 0, target.width, target.height);
      ctx.font = `${size}px monospace`;
      drops.forEach((y, i) => {
        const char = glyphs[Math.floor(Math.random() * glyphs.length)] ?? "0";
        ctx.fillStyle = Math.random() > 0.96 ? "#d6ffe0" : "#00ff66";
        ctx.fillText(char, i * size, y * size);
        drops[i] = y * size > target.height && Math.random() > 0.975 ? 0 : y + 1;
      });
    };
    frameId = requestAnimationFrame(tick);
    return () => {
      cancelAnimationFrame(frameId);
      window.removeEventListener("resize", resize);
    };
  };

  if (dialog && canvas) {
    let stopRain = () => {};

    const close = () => {
      stopRain();
      dialog.close();
      document.body.classList.remove("overflow-hidden");
    };

    const open = () => {
      if (dialog.open) return;
      dialog.showModal();
      document.body.classList.add("overflow-hidden");
      stopRain = startRain(canvas);
      dialog.querySelector<HTMLButtonElement>('button[data-pill-choice="matrix"]:not([tabindex])')?.focus();
    };

    const choose = (theme: Theme) => {
      applyTheme(theme);
      close();
    };

    dialog.querySelectorAll<HTMLButtonElement>("[data-pill-choice]").forEach((button) => {
      button.addEventListener("click", () =>
        choose(button.dataset.pillChoice === "matrix" ? "matrix" : "abyss"),
      );
    });

    // Omitir (botón o Esc) también elige: la píldora azul, el tema por defecto.
    dialog.querySelector("[data-pill-skip]")?.addEventListener("click", () => choose("abyss"));
    dialog.addEventListener("cancel", (event) => {
      event.preventDefault();
      choose("abyss");
    });

    window.addEventListener("keydown", (event) => {
      if (!dialog.open) return;
      const key = event.key.toLowerCase();
      if (key === "r") {
        event.preventDefault();
        choose("matrix");
      } else if (key === "a" || key === "b") {
        event.preventDefault();
        choose("abyss");
      }
    });

    // Se abre solo si todavía no se ha elegido ninguna píldora.
    if (!getSavedTheme()) setTimeout(open, 400);

    window.addEventListener("open-matrix-pill", open);
  }
</script>
