---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  className?: string;
}

const { project, className } = Astro.props;

const statusLabel: Record<Project["status"], string> = {
  completed: "completado",
  "in-progress": "en desarrollo",
  planned: "planificado",
};
---

<article
  data-reveal
  class={[
    "group relative overflow-hidden rounded-lg border border-border bg-surface/80 backdrop-blur-sm transition duration-300 hover:-translate-y-1 hover:border-accent/60 hover:shadow-[0_0_40px_-12px_rgb(62_230_193/0.5)]",
    className,
  ]
    .filter(Boolean)
    .join(" ")}
>
  <div class="flex items-center gap-3 border-b border-border px-4 py-2.5 font-mono text-xs text-muted">
    <span aria-hidden="true" class="flex gap-1.5">
      <span class="size-2.5 rounded-full bg-accent"></span>
      <span class="size-2.5 rounded-full bg-accent-2"></span>
      <span class="size-2.5 rounded-full bg-border"></span>
    </span>
    <span class="truncate">~/proyectos/{project.id}</span>
    <span class="ml-auto shrink-0 text-accent">
      [ {statusLabel[project.status]} ]
    </span>
  </div>
  {project.image && (
    <div class="relative aspect-video overflow-hidden border-b border-border">
      <img
        src={project.image}
        alt=""
        class="absolute inset-0 h-full w-full object-cover opacity-80 transition duration-500 group-hover:scale-105 group-hover:opacity-100"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent"></div>
    </div>
  )}
  <div class="p-6">
    <h3 class="text-xl font-semibold tracking-tight text-foreground group-hover:text-accent transition-colors">
      {project.title}
    </h3>
    <p class="mt-3 text-sm text-muted">{project.description}</p>
    <div
      class="mt-4 flex flex-wrap gap-1.5"
      aria-label="Tecnologías utilizadas"
    >
      {project.technologies.map((tech) => (
        <span class="rounded border border-accent/25 bg-accent/5 px-2 py-0.5 font-mono text-xs text-foreground/80">
          {tech}
        </span>
      ))}
    </div>
    <div class="mt-4 pt-4 border-t border-border">
      <p class="text-xs text-muted mb-3">
        <span class="font-mono text-accent-2">aportación:</span>{" "}
        {project.personalContribution}
      </p>
      <div class="flex gap-3">
        {project.repo && (
          <a
            href={project.repo}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-mono text-accent hover:underline flex items-center gap-1"
            aria-label={`Ver repositorio de ${project.title}`}
          >
            <svg
              class="w-4 h-4"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z" />
            </svg>
            Código
          </a>
        )}
        {project.demo && (
          <a
            href={project.demo}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-mono text-accent hover:underline flex items-center gap-1"
            aria-label={`Ver demo de ${project.title}`}
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              />
            </svg>
            Demo
          </a>
        )}
      </div>
    </div>
  </div>
</article>
