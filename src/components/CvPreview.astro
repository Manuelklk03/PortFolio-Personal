---
// Vista previa del CV integrada en el estilo terminal: la página se "imprime" al entrar en pantalla.
interface Props {
  url: string;
  name: string;
}

const { url, name } = Astro.props;
const fileName = url.split("/").pop() ?? "curriculum.pdf";
---

<div data-cv-preview data-url={url} class="font-mono">
  <div class="border border-border bg-surface/60">
    <p
      class="flex flex-wrap items-baseline justify-between gap-2 border-b border-border px-4 py-2.5 text-xs text-muted"
    >
      <span><span class="text-accent-2">$</span> cat {fileName}</span>
      <span aria-hidden="true">PDF</span>
    </p>

    <!-- Escenario: un halo suave detrás y la hoja elevada, que se funde con el fondo por abajo. -->
    <div
      class="relative isolate max-h-[30rem] overflow-hidden px-3 pt-6 [mask-image:linear-gradient(to_bottom,#000_62%,transparent)] sm:max-h-[34rem] sm:px-10 sm:pt-10"
    >
      <div
        aria-hidden="true"
        class="absolute inset-x-0 top-0 -z-10 h-full bg-[radial-gradient(ellipse_at_50%_20%,color-mix(in_srgb,var(--color-accent)_14%,transparent),transparent_65%)]"
      >
      </div>
      <div>
        <!-- Mientras pdf.js carga (o si falla) se muestra un aviso en lugar de un hueco vacío. -->
        <p data-cv-status class="px-1 py-10 text-sm text-muted">
          <span class="text-accent-2">&gt;</span> cargando {fileName}…
        </p>
        <canvas
          role="img"
          aria-label={`Vista previa del currículum de ${name}`}
          class="mx-auto hidden shadow-[0_30px_60px_-24px_rgb(0_0_0/0.75),0_0_0_1px_var(--color-border)]"
        ></canvas>
      </div>
    </div>

    <div
      class="flex flex-wrap items-center gap-3 border-t border-border px-4 py-4 text-sm"
    >
      <a
        href={url}
        download
        class="inline-flex min-h-11 items-center gap-2 bg-accent px-5 py-2 font-medium text-background transition hover:bg-foreground sm:min-h-0"
      >
        <span aria-hidden="true">↓</span> descargar CV
      </a>
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="term-select inline-flex min-h-11 items-center gap-2 border border-accent/50 px-5 py-2 text-accent sm:min-h-0"
      >
        <span aria-hidden="true">↗</span> abrir completo
        <span class="sr-only">(se abre en una pestaña nueva)</span>
      </a>
    </div>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-cv-preview]");
  const canvas = root?.querySelector("canvas");
  const status = root?.querySelector<HTMLElement>("[data-cv-status]");
  const url = root?.dataset.url;

  if (root && canvas && status && url) {
    // pdf.js solo se descarga cuando la sección del CV se acerca a la pantalla.
    const observer = new IntersectionObserver(
      async ([entry]) => {
        if (!entry?.isIntersecting) return;
        observer.disconnect();
        const { renderCvPreview } = await import("../scripts/cv-preview");
        const ok = await renderCvPreview(canvas, url);
        if (ok) {
          status.remove();
          canvas.classList.remove("hidden");
          canvas.classList.add("cv-print");
        } else {
          status.textContent =
            "> no se pudo mostrar la vista previa; usa «abrir completo».";
        }
      },
      { rootMargin: "300px 0px" },
    );
    observer.observe(root);
  }
</script>
