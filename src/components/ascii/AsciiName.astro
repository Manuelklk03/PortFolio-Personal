---
// figlet se ejecuta al compilar: el navegador recibe el dibujo ya hecho.
import figlet from "figlet";
import ansiShadow from "figlet/importable-fonts/ANSI Shadow.js";

interface Props {
  lines: string[];
}

const { lines } = Astro.props;

figlet.parseFont("ANSI Shadow", ansiShadow);
const art = lines
  .map((line) => figlet.textSync(line, { font: "ANSI Shadow" }).trimEnd())
  .join("\n");
---

<div data-ascii-name class="relative">
  <pre
    data-ascii-source
    aria-hidden="true"
    class="overflow-hidden font-mono text-[clamp(6px,2.5vw,14px)] leading-none text-accent"
  >{art}</pre>
  <canvas
    aria-hidden="true"
    class="pointer-events-none absolute top-0 left-0 hidden"
  ></canvas>
</div>

<script>
  import { whenIntroDone } from "../../scripts/intro-gate";

  interface Particle {
    char: string;
    homeX: number;
    homeY: number;
    x: number;
    y: number;
    vx: number;
    vy: number;
    color: string;
  }

  // Caracteres que aparecen cuando una partícula se aleja de su sitio.
  const DUST = "▓▒░·";
  const RADIUS = 90;
  const PUSH = 2.4;
  const SPRING = 0.06;
  const DAMPING = 0.82;

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  // Mezcla dos colores hex o rgb según t (0–1).
  const mix = (a: string, b: string, t: number) => {
    // Soporte para #hex
    if (a.startsWith("#") && b.startsWith("#")) {
      const ca = [1, 3, 5].map((i) => parseInt(a.slice(i, i + 2), 16));
      const cb = [1, 3, 5].map((i) => parseInt(b.slice(i, i + 2), 16));
      const c = ca.map((v, i) => Math.round(v + ((cb[i] ?? v) - v) * t));
      return `rgb(${c.join(",")})`;
    }
    return t < 0.5 ? a : b;
  };

  document
    .querySelectorAll<HTMLElement>("[data-ascii-name]")
    .forEach((root) => {
      const pre = root.querySelector<HTMLElement>("[data-ascii-source]");
      const canvas = root.querySelector("canvas");
      const ctx = canvas?.getContext("2d");
      if (!pre || !canvas || !ctx) return;

      const text = pre.textContent ?? "";
      let particles: Particle[] = [];
      let charWidth = 0;
      let frameId: number | null = null;
      const pointer = { x: -9999, y: -9999 };
      let dustColor = "#ddf7f0";

      const setup = (intro: boolean) => {
        const styles = getComputedStyle(document.documentElement);
        const jade =
          styles.getPropertyValue("--color-accent").trim() || "#3ee6c1";
        const teal =
          styles.getPropertyValue("--color-accent-2").trim() || "#13a9a3";
        dustColor =
          styles.getPropertyValue("--color-foreground").trim() || "#ddf7f0";

        const computed = getComputedStyle(pre);
        const rect = pre.getBoundingClientRect();
        const dpr = Math.min(window.devicePixelRatio, 2);
        // Tamaño en píxeles de dispositivo enteros: un canvas con medidas fraccionarias se reescala y se ve borroso.
        const pixelWidth = Math.round(rect.width * dpr);
        const pixelHeight = Math.round(rect.height * dpr);
        canvas.width = pixelWidth;
        canvas.height = pixelHeight;
        canvas.style.width = `${pixelWidth / dpr}px`;
        canvas.style.height = `${pixelHeight / dpr}px`;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.font = `${computed.fontWeight} ${computed.fontSize} ${computed.fontFamily}`;
        ctx.textBaseline = "top";

        charWidth = ctx.measureText("█").width;
        const lineHeight =
          parseFloat(computed.lineHeight) || parseFloat(computed.fontSize);
        const rows = text.split("\n");
        const columns = Math.max(...rows.map((row) => row.length));

        particles = [];
        rows.forEach((row, rowIndex) => {
          [...row].forEach((char, col) => {
            if (char === " ") return;
            const homeX = col * charWidth;
            const homeY = rowIndex * lineHeight;
            particles.push({
              char,
              homeX,
              homeY,
              // En la entrada las partículas llegan desde posiciones aleatorias.
              x: intro ? homeX + (Math.random() - 0.5) * rect.width : homeX,
              y: intro
                ? homeY + (Math.random() - 0.5) * rect.height * 3
                : homeY,
              vx: 0,
              vy: 0,
              // Degradado de izquierda a derecha
              color: mix(jade, teal, col / columns),
            });
          });
        });
      };

      const draw = () => {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        let moving = false;

        for (const p of particles) {
          const dx = p.x - pointer.x;
          const dy = p.y - pointer.y;
          const distance = Math.hypot(dx, dy);
          if (distance < RADIUS && distance > 0) {
            const force = (1 - distance / RADIUS) * PUSH;
            p.vx += (dx / distance) * force;
            p.vy += (dy / distance) * force;
          }

          p.vx = (p.vx + (p.homeX - p.x) * SPRING) * DAMPING;
          p.vy = (p.vy + (p.homeY - p.y) * SPRING) * DAMPING;
          p.x += p.vx;
          p.y += p.vy;

          const offset = Math.hypot(p.x - p.homeX, p.y - p.homeY);
          if (offset > 0.3 || Math.abs(p.vx) + Math.abs(p.vy) > 0.05)
            moving = true;

          // Cuanto más lejos de casa, más se "deshace" el carácter.
          const dustIndex = Math.min(DUST.length - 1, Math.floor(offset / 14));
          const char = offset > 4 ? (DUST[dustIndex] ?? p.char) : p.char;
          ctx.fillStyle = offset > 4 ? dustColor : p.color;
          // En reposo se dibuja sobre píxeles enteros para que los bloques queden nítidos.
          ctx.fillText(char, Math.round(p.x), Math.round(p.y));
        }

        // Sin movimiento, con el ratón lejos o fuera de pantalla, el bucle se para.
        const pointerNear = pointer.x > -RADIUS && pointer.y > -RADIUS;
        frameId =
          visible && (moving || pointerNear)
            ? requestAnimationFrame(draw)
            : null;
      };

      const play = () => {
        if (frameId === null) frameId = requestAnimationFrame(draw);
      };

      const updatePointer = (event: PointerEvent) => {
        const rect = canvas.getBoundingClientRect();
        pointer.x = event.clientX - rect.left;
        pointer.y = event.clientY - rect.top;
        play();
      };

      // Clic sobre el nombre: onda expansiva que empuja las partículas hacia fuera.
      const shockwave = (event: MouseEvent) => {
        const rect = canvas.getBoundingClientRect();
        const originX = event.clientX - rect.left;
        const originY = event.clientY - rect.top;
        for (const p of particles) {
          const dx = p.x - originX;
          const dy = p.y - originY;
          const dist = Math.hypot(dx, dy);
          if (dist < 180 && dist > 0) {
            const power = (1 - dist / 180) * 14;
            p.vx += (dx / dist) * power;
            p.vy += (dy / dist) * power;
          }
        }
        play();
      };

      let visible = true;
      let enabled = false;

      const enable = (intro: boolean) => {
        if (reducedMotion.matches) {
          pre.style.visibility = "visible";
          canvas.classList.add("hidden");
          return;
        }
        enabled = true;
        setup(intro);
        pre.style.visibility = "hidden";
        canvas.classList.remove("hidden");
        window.addEventListener("pointermove", updatePointer);
        root.addEventListener("pointerdown", shockwave);
        play();
      };

      // Vuelve al texto estático (movimiento reducido).
      const disable = () => {
        enabled = false;
        if (frameId !== null) cancelAnimationFrame(frameId);
        frameId = null;
        canvas.classList.add("hidden");
        pre.style.visibility = "visible";
        window.removeEventListener("pointermove", updatePointer);
        root.removeEventListener("pointerdown", shockwave);
      };

      new IntersectionObserver(([entry]) => {
        visible = entry?.isIntersecting ?? false;
        if (visible) play();
      }).observe(root);

      window.addEventListener("resize", () => {
        if (!enabled) return;
        setup(false);
        play();
      });

      window.addEventListener("themechange", () => {
        if (!enabled) return;
        setup(false);
        play();
      });

      reducedMotion.addEventListener("change", () => {
        if (reducedMotion.matches) disable();
        else enable(false);
      });

      // Las partículas esperan a que se elija píldora; así también nacen ya con los colores del tema.
      whenIntroDone(() => enable(true));
    });
</script>
