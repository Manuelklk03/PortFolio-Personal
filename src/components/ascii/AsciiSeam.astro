---
// Final del inicio: una franja de tramado ASCII que se desvanece hacia la página. Se genera al compilar.
import { dissolveBand } from "../../lib/ascii-art";

const band = dissolveBand(320, 5);
---

<!-- La máscara apaga los bordes laterales para que no termine en corte seco. -->
<pre
  aria-hidden="true"
  class="pointer-events-none overflow-hidden font-mono text-[12px] leading-[1.1] whitespace-pre text-accent/30 select-none [mask-image:linear-gradient(to_right,transparent,black_18%,black_82%,transparent)]"
>{band}</pre>
