---
// Fondo 3D en ASCII que gira solo. Todo ocurre en el <script>, en el navegador.
---

<div
  data-ascii-scene
  aria-hidden="true"
  class="pointer-events-none absolute inset-0 -z-10 overflow-hidden font-mono text-accent/30 select-none"
></div>
<!-- Las animaciones automáticas de más de 5 s necesitan poder pausarse (WCAG 2.2.2). -->
<button
  type="button"
  data-ascii-toggle
  class="absolute right-[max(1rem,calc((100%-64rem)/2+1rem))] bottom-4 hidden rounded border border-border bg-background/70 px-3 py-1.5 font-mono text-xs text-muted backdrop-blur transition hover:border-accent/60 hover:text-accent"
>
  [ pausar fondo ]
</button>

<script>
  const container = document.querySelector<HTMLElement>("[data-ascii-scene]");
  const toggle = document.querySelector<HTMLButtonElement>(
    "[data-ascii-toggle]",
  );
  // En móvil no se carga: el nombre en ASCII basta y se ahorra batería y datos.
  const isLargeScreen = window.matchMedia("(min-width: 768px)").matches;
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (container && toggle && isLargeScreen) {
    // Three.js solo se descarga cuando el inicio entra en pantalla.
    const observer = new IntersectionObserver(async ([entry]) => {
      if (!entry?.isIntersecting) return;
      observer.disconnect();
      const { startAsciiScene } = await import("../../scripts/ascii-scene");
      const controls = startAsciiScene(container);
      if (!controls) return;

      // El botón solo tiene sentido cuando el fondo se mueve.
      const syncButton = () =>
        toggle.classList.toggle("hidden", reducedMotion.matches);
      syncButton();
      reducedMotion.addEventListener("change", syncButton);

      // El texto del botón dice la acción que hará; por eso no lleva aria-pressed.
      let paused = false;
      toggle.addEventListener("click", () => {
        paused = !paused;
        toggle.textContent = paused ? "[ reanudar fondo ]" : "[ pausar fondo ]";
        controls.setPaused(paused);
      });
    });
    observer.observe(container);
  }
</script>
