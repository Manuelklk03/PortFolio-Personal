---
// Un proyecto como tarjeta que lleva a su página de detalle (/proyectos/<id>).
// Sin captura, la tarjeta muestra la firma ASCII del proyecto.
import type { Project } from "@/data/projects";
import { blockLetters } from "@/lib/ascii-art";
import { statusLabel, statusColor } from "@/lib/project-status";

interface Props {
  project: Project;
}

const { project } = Astro.props;

// Los "permisos" dan una pista visual del estado, como en una terminal.
const permissions: Record<Project["status"], string> = {
  completed: "drwxr-xr-x",
  "in-progress": "drwxr-x---",
  planned: "d---------",
};

const signature = blockLetters(project.monogram);
---

<li data-reveal class="h-full">
  <a
    href={`/proyectos/${project.id}`}
    data-scramble-trigger
    class="group flex h-full flex-col border border-border bg-surface/60 transition-colors hover:border-accent/70 hover:bg-accent/5"
  >
    <div
      class="flex aspect-video items-center justify-center overflow-hidden border-b border-border bg-background"
    >
      {
        project.image ? (
          <img
            src={project.image}
            alt={`Captura de ${project.title}`}
            loading="lazy"
            class="h-full w-full object-cover"
          />
        ) : (
          <pre
            aria-hidden="true"
            class="font-mono text-[9px] leading-none text-accent-2 transition-colors select-none group-hover:text-accent sm:text-[10px]"
          >{signature}</pre>
        )
      }
    </div>

    <div class="flex flex-1 flex-col p-5 font-mono">
      <p class="flex flex-wrap items-baseline gap-x-3 gap-y-1 text-xs">
        <span aria-hidden="true" class="text-muted">
          {permissions[project.status]}
        </span>
        <span class={statusColor[project.status]}>
          [{statusLabel[project.status]}]
        </span>
      </p>
      <h3 class="mt-3 text-xl font-semibold tracking-tight text-foreground">
        <span class="sr-only">{project.title}</span>
        <span aria-hidden="true" data-scramble>{project.title}</span>
      </h3>
      <p class="mt-2 line-clamp-3 font-sans text-sm text-muted">
        {project.description}
      </p>
      <p class="mt-auto pt-5 text-sm text-accent">
        <span aria-hidden="true">$ cd {project.id}</span>
        <span
          aria-hidden="true"
          class="ml-1 inline-block transition-transform group-hover:translate-x-1"
          >→</span
        >
        <span class="sr-only">Ver detalle de {project.title}</span>
      </p>
    </div>
  </a>
</li>
