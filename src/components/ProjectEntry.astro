---
// Un proyecto como fila de `ls -l`: permisos, nombre, estado, stack y enlaces.
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;

const statusLabel: Record<Project["status"], string> = {
  completed: "completado",
  "in-progress": "en desarrollo",
  planned: "planificado",
};

// Los "permisos" dan una pista visual del estado, como en una terminal.
const permissions: Record<Project["status"], string> = {
  completed: "drwxr-xr-x",
  "in-progress": "drwxr-x---",
  planned: "d---------",
};

const links = [
  ...(project.repo ? [{ href: project.repo, label: "código" }] : []),
  ...(project.demo ? [{ href: project.demo, label: "demo" }] : []),
];
---

<li
  data-reveal
  class="group border-b border-border transition-colors hover:bg-accent/5"
>
  <article
    aria-labelledby={`project-${project.id}`}
    class="grid gap-6 px-1 py-7 sm:px-4 lg:grid-cols-[1fr_14rem]"
  >
    <div>
      <p class="flex flex-wrap items-baseline gap-x-4 gap-y-1 font-mono text-sm">
        <span aria-hidden="true" class="text-muted">
          {permissions[project.status]}
        </span>
        <span class="text-accent-2">{project.id}/</span>
        <span class="text-accent">[{statusLabel[project.status]}]</span>
      </p>
      <h3
        id={`project-${project.id}`}
        class="mt-3 text-xl font-semibold tracking-tight text-foreground transition-colors group-hover:text-accent"
      >
        {project.title}
      </h3>
      <p class="mt-2 max-w-2xl text-muted">{project.description}</p>
      <p class="mt-4 font-mono text-sm text-muted">
        <span class="text-accent-2">--stack</span>{" "}
        {project.technologies.join(" · ")}
      </p>
      <p class="mt-1 font-mono text-sm text-muted">
        <span class="text-accent-2">--aportación</span>{" "}
        {project.personalContribution}
      </p>
      {links.length > 0 && (
        <ul class="mt-4 flex gap-5 font-mono text-sm">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-11 items-center gap-1 text-accent underline-offset-4 hover:underline sm:min-h-0"
              >
                <span aria-hidden="true">↗</span> {link.label}
                <span class="sr-only">de {project.title}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
    {project.image && (
      <div class="hidden self-start overflow-hidden rounded border border-border lg:block">
        <img
          src={project.image}
          alt=""
          loading="lazy"
          class="aspect-video w-full object-cover opacity-50 grayscale transition duration-300 group-hover:opacity-100 group-hover:grayscale-0"
        />
      </div>
    )}
  </article>
</li>
