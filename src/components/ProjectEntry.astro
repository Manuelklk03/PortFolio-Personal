---
// Un proyecto como bloque grande: visual a un lado (captura o firma ASCII) y a otro el texto,
// el stack y dos acciones. Los bloques alternan de lado. El detalle vive en /proyectos/<id>.
import type { Project } from "@/data/projects";
import { blockLetters } from "@/lib/ascii-art";
import { getTechIcon } from "@/lib/tech-icons";
import { statusLabel, statusColor } from "@/lib/project-status";

interface Props {
  project: Project;
  // Posición en la lista: los impares invierten el orden en pantallas anchas.
  index: number;
}

const { project, index } = Astro.props;

// Los "permisos" dan una pista visual del estado, como en una terminal.
const permissions: Record<Project["status"], string> = {
  completed: "drwxr-xr-x",
  "in-progress": "drwxr-x---",
  planned: "d---------",
};

const signature = blockLetters(project.monogram);
const detailUrl = `/proyectos/${project.id}`;

// Acción principal: la web si existe; si no, el código.
const primary = project.demo
  ? { href: project.demo, label: "Abrir web" }
  : project.repo
    ? { href: project.repo, label: "Ver código" }
    : null;
const reversed = index % 2 === 1;
---

<li data-reveal>
  <article
    class="grid items-center gap-6 lg:grid-cols-2 lg:gap-12"
    aria-labelledby={`project-${project.id}`}
  >
    <!-- Visual: no añade nada que el texto no diga, así que queda fuera del orden de lectura. -->
    <a
      href={detailUrl}
      tabindex="-1"
      aria-hidden="true"
      class:list={[
        "group flex aspect-[4/3] items-center justify-center overflow-hidden border border-border bg-surface/60 transition-colors hover:border-accent/70",
        reversed && "lg:order-last",
      ]}
    >
      {
        project.image ? (
          <img
            src={project.image}
            alt=""
            loading="lazy"
            class="h-full w-full object-cover object-top"
          />
        ) : (
          <pre
            class="font-mono text-[clamp(10px,2.2vw,18px)] leading-none text-accent-2 transition-colors select-none group-hover:text-accent"
          >{signature}</pre>
        )
      }
    </a>

    <div data-scramble-trigger class="min-w-0 font-mono">
      <p class="flex flex-wrap items-baseline gap-x-3 gap-y-1 text-xs">
        <span aria-hidden="true" class="text-muted">
          {permissions[project.status]}
        </span>
        <span class={statusColor[project.status]}>
          [{statusLabel[project.status]}]
        </span>
      </p>
      <h3
        id={`project-${project.id}`}
        class="mt-3 text-2xl font-semibold tracking-tight text-foreground sm:text-3xl"
      >
        <span class="sr-only">{project.title}</span>
        <span aria-hidden="true" data-scramble>{project.title}</span>
      </h3>
      <p class="mt-4 max-w-xl font-sans text-base leading-relaxed text-muted">
        {project.description}
      </p>

      <ul class="mt-5 flex flex-wrap gap-2" aria-label="Tecnologías">
        {
          project.technologies.map((tech) => {
            const icon = getTechIcon(tech);
            return (
              <li class="inline-flex items-center gap-2 border border-border px-2.5 py-1 text-xs text-muted">
                {icon.kind === "path" && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                    class="size-3.5"
                  >
                    <path d={icon.path} />
                  </svg>
                )}
                {tech}
              </li>
            );
          })
        }
      </ul>

      <div class="mt-7 flex flex-wrap gap-3 text-sm">
        {
          primary && (
            <a
              href={primary.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center gap-2 bg-accent px-5 py-2 font-medium text-background transition hover:bg-foreground sm:min-h-0"
            >
              {primary.label}
              <span aria-hidden="true">↗</span>
              <span class="sr-only">de {project.title} (pestaña nueva)</span>
            </a>
          )
        }
        <a
          href={detailUrl}
          class:list={[
            "term-select inline-flex min-h-11 items-center gap-2 px-5 py-2 sm:min-h-0",
            primary
              ? "border border-accent/50 text-accent"
              : "bg-accent font-medium text-background",
          ]}
        >
          Más detalle
          <span aria-hidden="true">→</span>
          <span class="sr-only">de {project.title}</span>
        </a>
      </div>
    </div>
  </article>
</li>
