---
// Un proyecto como fila de `ls -l` que se despliega al hacer clic (como `cat proyecto/README`).
// `name="projects"` hace que solo haya uno abierto a la vez.
import type { Project } from "../data/projects";
import { blockLetters } from "../lib/ascii-art";

interface Props {
  project: Project;
}

const { project } = Astro.props;

const statusLabel: Record<Project["status"], string> = {
  completed: "completado",
  "in-progress": "en desarrollo",
  planned: "planificado",
};

// Los "permisos" dan una pista visual del estado, como en una terminal.
const permissions: Record<Project["status"], string> = {
  completed: "drwxr-xr-x",
  "in-progress": "drwxr-x---",
  planned: "d---------",
};

// Cada estado con su color: lo terminado destaca más que lo previsto.
const statusColor: Record<Project["status"], string> = {
  completed: "text-accent",
  "in-progress": "text-accent-2",
  planned: "text-muted",
};

const signature = blockLetters(project.monogram);

const links = [
  ...(project.repo ? [{ href: project.repo, label: "código" }] : []),
  ...(project.demo ? [{ href: project.demo, label: "demo" }] : []),
];
---

<li data-reveal class="border-b border-border">
  <details name="projects" data-project={project.id} class="group">
    <summary
      data-scramble-trigger
      class="grid cursor-pointer list-none gap-4 px-1 py-6 transition-colors hover:bg-accent/5 sm:px-4 lg:grid-cols-[1fr_auto] [&::-webkit-details-marker]:hidden"
    >
      <div>
        <p
          class="flex flex-wrap items-baseline gap-x-4 gap-y-1 font-mono text-sm"
        >
          <span aria-hidden="true" class="text-muted">
            {permissions[project.status]}
          </span>
          <span class="text-accent-2">{project.id}/</span>
          <span class={statusColor[project.status]}>
            [{statusLabel[project.status]}]
          </span>
        </p>
        <h3
          id={`project-${project.id}`}
          class="mt-3 flex items-baseline gap-3 text-xl font-semibold tracking-tight text-foreground"
        >
          <span class="sr-only">{project.title}</span>
          <span aria-hidden="true" data-scramble>{project.title}</span>
          <span
            aria-hidden="true"
            class="font-mono text-sm font-normal text-accent-2 group-open:hidden"
            >[+]</span
          >
          <span
            aria-hidden="true"
            class="hidden font-mono text-sm font-normal text-accent group-open:inline"
            >[-]</span
          >
        </h3>
        <p class="mt-2 max-w-2xl text-muted">{project.description}</p>
      </div>
      <!-- Firma del proyecto en letras de bloque, generada al compilar. -->
      <pre
        aria-hidden="true"
        class="order-first font-mono text-[7px] leading-none text-accent-2 transition-colors select-none group-hover:text-accent group-open:text-accent lg:order-last lg:text-[9px]"
      >{signature}</pre>
    </summary>

    <div class="grid gap-6 px-1 pb-8 sm:px-4 lg:grid-cols-[1fr_16rem]">
      <div class="font-mono text-sm text-muted">
        <p class="text-accent-2">$ cat {project.id}/README.md</p>
        <p class="mt-3">
          <span class="text-accent-2">--stack</span>{" "}
          {project.technologies.join(" · ")}
        </p>
        <p class="mt-1">
          <span class="text-accent-2">--aportación</span>{" "}
          {project.personalContribution}
        </p>
        {
          links.length > 0 && (
            <ul class="mt-4 flex gap-5">
              {links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="term-select -mx-1 inline-flex min-h-11 items-center gap-1 px-1 text-accent sm:min-h-0"
                  >
                    <span aria-hidden="true">↗</span> {link.label}
                    <span class="sr-only">de {project.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
      {
        project.image && (
          <div class="overflow-hidden border border-border">
            <img
              src={project.image}
              alt={`Captura de ${project.title}`}
              loading="lazy"
              class="aspect-video w-full object-cover"
            />
          </div>
        )
      }
    </div>
  </details>
</li>
