---
// Un proyecto como fila de `ls -l`: permisos, nombre, estado, stack y enlaces.
import type { Project } from "../data/projects";
import { blockLetters } from "../lib/ascii-art";

interface Props {
  project: Project;
}

const { project } = Astro.props;

const statusLabel: Record<Project["status"], string> = {
  completed: "completado",
  "in-progress": "en desarrollo",
  planned: "planificado",
};

// Los "permisos" dan una pista visual del estado, como en una terminal.
const permissions: Record<Project["status"], string> = {
  completed: "drwxr-xr-x",
  "in-progress": "drwxr-x---",
  planned: "d---------",
};

// Cada estado con su color: lo terminado destaca más que lo previsto.
const statusColor: Record<Project["status"], string> = {
  completed: "text-accent",
  "in-progress": "text-accent-2",
  planned: "text-muted",
};

const signature = blockLetters(project.monogram);

const links = [
  ...(project.repo ? [{ href: project.repo, label: "código" }] : []),
  ...(project.demo ? [{ href: project.demo, label: "demo" }] : []),
];
---

<li data-reveal class="group border-b border-border">
  <article
    aria-labelledby={`project-${project.id}`}
    class="grid gap-6 px-1 py-7 sm:px-4 lg:grid-cols-[1fr_14rem]"
  >
    <div>
      <p class="flex flex-wrap items-baseline gap-x-4 gap-y-1 font-mono text-sm">
        <span aria-hidden="true" class="text-muted">
          {permissions[project.status]}
        </span>
        <span class="text-accent-2">{project.id}/</span>
        <span class={statusColor[project.status]}>
          [{statusLabel[project.status]}]
        </span>
      </p>
      <h3
        id={`project-${project.id}`}
        class="mt-3 text-xl font-semibold tracking-tight text-foreground"
      >
        {project.title}
      </h3>
      <p class="mt-2 max-w-2xl text-muted">{project.description}</p>
      <p class="mt-4 font-mono text-sm text-muted">
        <span class="text-accent-2">--stack</span>{" "}
        {project.technologies.join(" · ")}
      </p>
      <p class="mt-1 font-mono text-sm text-muted">
        <span class="text-accent-2">--aportación</span>{" "}
        {project.personalContribution}
      </p>
      {links.length > 0 && (
        <ul class="mt-4 flex gap-5 font-mono text-sm">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="term-select -mx-1 inline-flex min-h-11 items-center gap-1 px-1 text-accent sm:min-h-0"
              >
                <span aria-hidden="true">↗</span> {link.label}
                <span class="sr-only">de {project.title}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
    <div class="order-first flex flex-col gap-4 self-start lg:order-last">
      <!-- Firma del proyecto en letras de caja, generada al compilar. -->
      <pre
        aria-hidden="true"
        class="font-mono text-[7px] leading-none text-accent-2 transition-colors select-none group-hover:text-accent lg:text-[9px]"
      >{signature}</pre>
      {project.image && (
        <div class="hidden overflow-hidden border border-border lg:block">
          <img
            src={project.image}
            alt=""
            loading="lazy"
            class="aspect-video w-full object-cover opacity-50 grayscale transition duration-300 group-hover:opacity-100 group-hover:grayscale-0"
          />
        </div>
      )}
    </div>
  </article>
</li>
