---
import { profile } from "../data/profile";

const year = new Date().getFullYear();

const socialLinks = [
  { href: profile.github, label: "GitHub" },
  { href: profile.linkedin, label: "LinkedIn" },
];
---

<footer class="border-t border-border">
  <div class="mx-auto flex max-w-5xl flex-col gap-4 px-4 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
    <p class="font-mono">© {year} {profile.name} <span class="text-accent-2">· hecho con Astro</span></p>
    <ul class="flex gap-5">
      {socialLinks.map((link) => (
        <li>
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors hover:text-accent"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>
