---
// Cierre de la sesión de terminal: secciones, perfiles y `exit` con cursor.
import { profile } from "@/data/profile";

const year = new Date().getFullYear();

// Las anclas llevan "/" para funcionar también desde las páginas de detalle.
const sections = [
  { href: "/#sobre-mi", label: "sobre-mi" },
  { href: "/#proyectos", label: "proyectos" },
  { href: "/#stack", label: "stack" },
  ...(profile.cvUrl ? [{ href: "/#cv", label: "cv" }] : []),
  { href: "/#contacto", label: "contacto" },
];

const profiles = [
  { href: profile.github, label: "github", external: true },
  { href: profile.linkedin, label: "linkedin", external: true },
  { href: `mailto:${profile.email}`, label: "correo", external: false },
];
---

<footer class="border-t border-border font-mono text-sm">
  <div class="mx-auto max-w-5xl px-4 py-12">
    <p aria-hidden="true" class="text-muted">
      <span class="text-accent">~/footer</span> $ ls
    </p>

    <div class="mt-6 grid gap-8 sm:grid-cols-2">
      <nav aria-labelledby="footer-sections">
        <h2 id="footer-sections" class="text-accent-2">--secciones</h2>
        <ul class="mt-3 grid grid-cols-2 gap-x-6">
          {
            sections.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="term-select -mx-1 inline-flex min-h-11 items-center px-1 text-foreground sm:min-h-0 sm:py-1"
                >
                  <span aria-hidden="true" class="text-accent-2">
                    ./
                  </span>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-labelledby="footer-profiles">
        <h2 id="footer-profiles" class="text-accent-2">--perfiles</h2>
        <ul class="mt-3 grid grid-cols-2 gap-x-6">
          {
            profiles.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? "_blank" : undefined}
                  rel={link.external ? "noopener noreferrer" : undefined}
                  class="term-select -mx-1 inline-flex min-h-11 items-center gap-1 px-1 text-foreground sm:min-h-0 sm:py-1"
                >
                  {link.label}
                  {link.external && (
                    <span aria-hidden="true" class="text-accent">
                      ↗
                    </span>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div
      class="mt-10 flex flex-col gap-4 border-t border-border pt-6 sm:flex-row sm:items-center sm:justify-between"
    >
      <p aria-hidden="true">
        <!-- prettier-ignore -->
        <span><span class="text-accent">manuel</span><span class="text-muted">@portfolio:~$</span> exit<span class="animate-blink text-accent">_</span></span>
      </p>
      <button
        type="button"
        data-scroll-top
        class="term-select -mx-1 inline-flex min-h-11 items-center gap-1 px-1 text-accent sm:min-h-0"
      >
        <span aria-hidden="true">↑</span> volver arriba
      </button>
    </div>

    <p class="mt-6 text-xs text-muted">© {year} {profile.name}</p>
  </div>
</footer>

<script>
  document
    .querySelector<HTMLButtonElement>("[data-scroll-top]")
    ?.addEventListener("click", () => {
      const reduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      window.scrollTo({ top: 0, behavior: reduced ? "instant" : "smooth" });
    });
</script>
